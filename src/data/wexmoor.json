  "dialogues": {
    "zunder_ankunft": {
      "start": "start",
      "nodes": {
        "start": {
          "text": "Eine junge Frau mit Ölkanister und rußigen Händen lehnt am Lagerhaus. Sie mustert deinen Ärmel, dann dein Gesicht, dann den Steckbrief an der Wand.\n\n„Da sind sie ja, die Fingerabdrücke. Kohlen-Jem hat telegrafiert. Einer von uns kommt, schrieb er, und er wird gesucht.“ Sie grinst. „Er hat nicht übertrieben.“",
          "choices": [
            {
              "text": "Wer bist du?",
              "next": "wer"
            },
            {
              "text": "Wo kann ich mich verstecken?",
              "next": "versteck"
            }
          ]
        },
        "wer": {
          "text": "„Juna Fenn. Alle sagen Zunder, weil ich Lampenöl verkaufe und schnell Feuer fange. Sagt meine Mutter.“ Sie wischt sich die Hand an der Hose ab und hält sie dir hin. „Rußgesellschaft, Wexmoorer Zweig. Wir sind weniger als ihr, aber wir haben mehr Keller.“",
          "choices": [
            {
              "text": "Wo kann ich mich verstecken?",
              "next": "versteck"
            }
          ]
        },
        "versteck": {
          "text": "„Nicht hier. Gleich kommt die Streife die Schleusenbrücke rauf, und die Grauspäher haben gute Laternen.“ Sie dreht sich zum Steckbrief. „Der hängt übrigens seit Dienstag. Dein Zug kam heute.“\n\n„Ich hab einen Kahn im Torfstich. Halb versunken, ganz trocken. Da kommt keine Streife hin, die haben Angst vorm Moor.“",
          "gives_clues": [
            "wx_zunder_poster"
          ],
          "choices": [
            {
              "text": "Der Steckbrief hing schon vorher?",
              "next": "papier"
            },
            {
              "text": "Bring mich hin.",
              "next": "los"
            }
          ]
        },
        "papier": {
          "text": "Zunder reißt den Zettel von der Wand und hält ihn gegen das Licht.",
          "gives_clues": [
            "wx_zunder_paper"
          ],
          "choices": [
            {
              "text": "Bring mich hin.",
              "next": "los"
            }
          ]
        },
        "los": {
          "text": "„Halt dich hinter mir. Wenn ich ‚Ratte‘ sage, gehst du in den nächsten Hauseingang und atmest nicht.“\n\nSie zieht dich zwischen zwei Kohlenwagen hindurch, über eine Leiter und durch ein Loch im Zaun. Der Torfstich liegt am Rand der Stadt. Wenn du die Stadtkarte öffnest, findest du ihn.",
          "sets_flags": [
            "k2_met_zunder"
          ],
          "choices": [
            {
              "text": "Los."
            }
          ]
        }
      }
    },
    "zunder": {
      "start": [
        {
          "node": "start"
        }
      ],
      "nodes": {
        "start": {
          "text": "Zunder sitzt auf einer umgedrehten Kiste und flickt einen Ölkanister. „Na, Gesuchter?“",
          "choices": [
            {
              "text": "Erzähl mir von Wexmoor.",
              "next": "stadt"
            },
            {
              "text": "Was ist mit dem Leuchtturm?",
              "next": "turm"
            },
            {
              "text": "Die Grauspäher. Worauf muss ich achten?",
              "next": "wache"
            },
            {
              "text": "Wie sieht dein Steckbrief-Papier nochmal aus?",
              "next": "papier",
              "hide_if_clues": [
                "wx_zunder_paper"
              ]
            },
            {
              "text": "Bis später."
            }
          ]
        },
        "stadt": {
          "text": "„Wexmoor steht auf Torf und sinkt. Jedes Jahr ein bisschen. Unten am Güterbahnhof die Schleusen, im Salzmarkt die Händler, am Bojenhafen die Fischer und Schmuggler. Oben in der Oberstadt das Lichtamt und die Akademie, da wohnen die, die nicht nasse Füße kriegen. Und draußen das Pfahldorf, da gehst du nur hin, wenn die Alten dich lassen.“\n\n„Wenn du hier was finden willst, musst du die Stadt erst kennen. Alle sechs Ecken.“",
          "choices": [
            {
              "text": "Noch was anderes.",
              "next": "start"
            }
          ]
        },
        "turm": {
          "text": "Zunder sieht aus dem Bullauge, dorthin, wo das Licht kreist. „Der brennt, seit es Wexmoor gibt. Ohne Öl, sagt man. Mein Onkel hat dreißig Jahre Lampenöl verkauft und nie einen Liter ans Lichtamt geliefert.“\n\n„Solange er brennt, bleibt das Moor draußen. Das sagen alle. Keiner fragt, womit.“",
          "choices": [
            {
              "text": "Noch was anderes.",
              "next": "start"
            }
          ]
        },
        "wache": {
          "text": "„Grauspäher laufen feste Runden, immer mit Laterne. Was im Lichtkegel steht, sehen sie. Bleib im Dunkeln, geh hinter Wagen und Fässer, und lauf nie direkt auf eine Laterne zu. Wenn einer ‚!‘ ruft, hast du einen Atemzug, um aus dem Licht zu kommen.“\n\n„Jedes Mal, wenn du ihnen davonläufst, suchen sie dich härter. Schlaf hier ein paar Nächte, dann vergessen sie dich wieder. Und wenn sie dich kriegen, hol ich dich raus. Zweimal umsonst. Dann kostet es.“",
          "choices": [
            {
              "text": "Noch was anderes.",
              "next": "start"
            }
          ]
        },
        "papier": {
          "text": "Zunder zieht den zerknitterten Steckbrief aus der Tasche und hält ihn an die Lampe.",
          "gives_clues": [
            "wx_zunder_paper"
          ],
          "choices": [
            {
              "text": "Noch was anderes.",
              "next": "start"
            }
          ]
        }
      }
    },
    "druce": {
      "start": "start",
      "nodes": {
        "start": {
          "text": "Ein alter Mann mit einem Schlüsselbund so groß wie ein Teller lehnt am Schleusenrad. Er sieht dich an, dann weg, dann wieder hin.\n\n„Ich hab nix gesehen. Ich seh nie was. Bin Schleusenwärter, ich guck aufs Wasser.“",
          "choices": [
            {
              "text": "Seit wann hängen die Steckbriefe?",
              "next": "zettel",
              "requires_clues": [
                "wx_steckbrief"
              ]
            },
            {
              "text": "Was macht die Schleuse?",
              "next": "schleuse"
            },
            {
              "text": "Schon gut."
            }
          ]
        },
        "zettel": {
          "text": "Er spuckt ins Wasser.",
          "gives_clues": [
            "wx_schleuse_poster"
          ],
          "choices": [
            {
              "text": "Danke.",
              "next": "start"
            }
          ]
        },
        "schleuse": {
          "text": "„Hält das Moorwasser draußen. Sechs Tore rund um die Stadt, ich hab das größte. Wenn die Flut kommt, schließ ich, und dann ist Ruhe.“ Er klopft auf das Rad. „Früher hat das gereicht. Jetzt steigt das Wasser auch, wenn keine Flut ist. Aber der Leuchtturm hält’s schon, sagen sie oben.“",
          "choices": [
            {
              "text": "Noch was.",
              "next": "start"
            }
          ]
        }
      }
    },
    "grauspaeher": {
      "start": "start",
      "nodes": {
        "start": {
          "text": "Ein Grauspäher in nassem Wachsmantel.",
          "choices": [
            {
              "text": "Weiter."
            }
          ]
        }
      }
    },
    "wx_zelle": {
      "start": "start",
      "nodes": {
        "start": {
          "text": "Das Gitter ist alt und das Schloss noch älter. Draußen im Gang schnarcht ein Grauspäher auf einem Stuhl, die Laterne zu seinen Füßen.",
          "choices": [
            {
              "text": "Auf Zunder warten.",
              "next": [
                {
                  "node": "bail_free",
                  "hide_if_flags": [
                    "k2_bail_due"
                  ]
                },
                {
                  "node": "bail_pay",
                  "requires_money": 15
                },
                {
                  "node": "bail_broke"
                }
              ]
            },
            {
              "text": "Das Schloss knacken.",
              "next": [
                {
                  "node": "pick_ok",
                  "chance": 0.45
                },
                {
                  "node": "pick_fail"
                }
              ]
            },
            {
              "text": "Noch nicht."
            }
          ]
        },
        "bail_free": {
          "text": "Gegen Morgen klappert etwas am Fenster. Zunder hängt kopfüber am Sims, einen Dietrich zwischen den Zähnen.\n\n„Der Wachmann schuldet mir Öl. Und ich ihm jetzt nichts mehr.“ Das Schloss springt auf. „Das war gratis. Lange bleibt das nicht so.“",
          "clears_flags": [
            "k2_in_cell"
          ],
          "travel": {
            "map": "wx_kahn",
            "spawn": "default"
          },
          "choices": [
            {
              "text": "Raus hier."
            }
          ]
        },
        "bail_pay": {
          "text": "Zunder kommt durch die Vordertür, mit einem Beutel Münzen und einem Lächeln, das dem Wachmann nicht gefällt. „Kaution. Für meinen Cousin, den Dummkopf.“\n\nDraußen hält sie die Hand auf. „Fünfzehn. Ich bin nicht die Heilsarmee.“",
          "takes_money": 15,
          "clears_flags": [
            "k2_in_cell"
          ],
          "travel": {
            "map": "wx_kahn",
            "spawn": "default"
          },
          "choices": [
            {
              "text": "Danke, Zunder."
            }
          ]
        },
        "bail_broke": {
          "text": "Zunder zahlt die Kaution aus eigener Tasche und redet den ganzen Heimweg nicht mit dir. Erst am Kahn sagt sie: „Das nächste Mal lass ich dich drin.“ Sie meint es nicht so. Hoffentlich.",
          "nerves": -15,
          "clears_flags": [
            "k2_in_cell"
          ],
          "travel": {
            "map": "wx_kahn",
            "spawn": "default"
          },
          "choices": [
            {
              "text": "Es tut mir leid."
            }
          ]
        },
        "pick_ok": {
          "text": "Ein Haken aus deinem Hosenbund, zwei Minuten Geduld, ein leises Klicken. Der Wachmann schnarcht weiter.\n\nDu schleichst durch den Hinterhof und über die Mauer. Als die Sonne aufgeht, stehst du am Güterbahnhof, als wärst du gerade erst angekommen.",
          "clears_flags": [
            "k2_in_cell"
          ],
          "travel": {
            "map": "wx_bahnhof",
            "spawn": "default"
          },
          "choices": [
            {
              "text": "Weg hier."
            }
          ]
        },
        "pick_fail": {
          "text": "Der Haken bricht ab. Der Wachmann schnieft, dreht sich um und schläft weiter. Dein Herz hämmert.",
          "nerves": -8,
          "choices": [
            {
              "text": "Nochmal überlegen.",
              "next": "start"
            }
          ]
        }
      }
    }
  },
