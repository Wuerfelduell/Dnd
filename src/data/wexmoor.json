  "case": {
    "facts": {
      "wx_expected": {
        "case": "kapitel2",
        "text": "Dein Steckbrief hing in Wexmoor schon, bevor dein Zug ankam. Jemand hier wusste, dass du kommst."
      },
      "wx_star_paper": {
        "case": "kapitel2",
        "text": "Der Wexmoorer Steckbrief ist auf Papier mit Sternwasserzeichen gedruckt, wie die anonymen Briefe in Kettlegate."
      }
    },
    "clues": {
      "wx_steckbrief": {
        "fact": "wx_star_paper",
        "source": "Eigene Beobachtung",
        "name": "Gesucht in Wexmoor",
        "text": "GESUCHT. Darunter dein Gesicht, gut getroffen, und ein falscher Name. „Mörder und Dieb aus Kettlegate. Belohnung beim Wachhaus Oberstadt.“\n\nGegen das Gaslicht gehalten zeigt das Papier ein Wasserzeichen: einen kleinen Stern."
      },
      "wx_zunder_poster": {
        "fact": "wx_expected",
        "source": "Zunder",
        "name": "Zwei Tage zu früh",
        "text": "„Die Zettel hängen seit Dienstag. Dein Zug kam heute. Entweder kannst du hellsehen, oder jemand anders kann es.“"
      },
      "wx_schleuse_poster": {
        "fact": "wx_expected",
        "source": "Schleusenwärter Abel Druce",
        "name": "Frisch geklebt, aber alt",
        "text": "„Die Grauspäher haben die Dinger Dienstagnacht geklebt. Hab mich noch gewundert. Kein Zug aus Kettlegate bis Freitag.“"
      },
      "wx_zunder_paper": {
        "fact": "wx_star_paper",
        "source": "Zunder",
        "name": "Teures Papier",
        "text": "Zunder reibt den Steckbrief zwischen den Fingern. „Das ist kein Wachhauspapier. Das ist Oberstadtpapier, mit Stern drin. So was kauft die Wache nicht.“"
      }
    },
    "deductions": [
      {
        "id": "dk2_erwartet",
        "case": "kapitel2",
        "pairs": [
          [
            "wx_expected",
            "wx_star_paper"
          ]
        ],
        "name": "Erwartet",
        "text": "Wer dir in Kettlegate die Briefe angehängt hat, hat dich auch hierher geschickt. Die Fahrkarte war kein Glück, sie war eine Einladung."
      }
    ]
  },
  "quests": {
    "k2_akt1": {
      "title": "Akt I: Ankunft im Moor",
      "kind": "main",
      "case": "kapitel2",
      "summary": "Du bist auf der Flucht in Wexmoor angekommen. Dein Steckbrief hängt schon an den Wänden. Eine junge Frau aus der Rußgesellschaft will dir helfen.",
      "steps": [
        {
          "text": "Sieh dich am Güterbahnhof um",
          "done": {
            "requires_any_clues": [
              "wx_steckbrief"
            ]
          }
        },
        {
          "text": "Sprich mit der Frau mit den rußigen Händen",
          "done": {
            "requires_flags": [
              "k2_met_zunder"
            ]
          }
        },
        {
          "text": "Folge Zunder zum Unterschlupf im Torfstich",
          "done": {
            "requires_flags": [
              "k2_hideout"
            ]
          }
        },
        {
          "text": "Finde heraus, wer wusste, dass du kommst",
          "done": {
            "requires_conclusions": [
              "dk2_erwartet"
            ]
          }
        },
        {
          "text": "Lerne die sechs Viertel von Wexmoor kennen (folgt bald)",
          "done": {
            "requires_flags": [
              "k2_city_known"
            ]
          }
        }
      ]
    }
  },
