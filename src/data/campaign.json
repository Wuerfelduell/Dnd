{
  "title": "Nebelakten",
  "start": {
    "map": "revier",
    "spawn": "start",
    "honor": 15,
    "quests": [
      "arrival"
    ],
    "hp": 40,
    "items": {
      "spazierstock": 1,
      "verband": 2
    },
    "weapon": "spazierstock",
    "intro_title": "Kettlegate, kurz vor Mitternacht",
    "intro": "Du bist neu in der Stadt: ein freier Ermittler, den das Polizeirevier Kettlegate anheuert, wenn die Constables nicht weiterwissen. Und in letzter Zeit wissen sie oft nicht weiter.\n\nNoch traut dir hier niemand. Dein Ansehen bei der Polizei entscheidet, welche Akten du lesen darfst und wer mit dir redet.\n\nMelde dich bei Inspektorin Marlowe. Ihr Büro ist hinten rechts."
  },
  "ranks": [
    {
      "min": 0,
      "name": "Zivilist",
      "text": "Das Revier duldet dich gerade so."
    },
    {
      "min": 20,
      "name": "Hilfsermittler",
      "text": "Constables zeigen dir Dienstbücher und Berichte."
    },
    {
      "min": 35,
      "name": "Ermittler",
      "text": "Das Archiv öffnet seine Unglücksakten. Zeugen nehmen dich ernst."
    },
    {
      "min": 50,
      "name": "Vertrauter des Reviers",
      "text": "Versiegelte Akten, vertrauliche Gespräche mit der Inspektorin. Verdächtige knicken schneller ein."
    },
    {
      "min": 70,
      "name": "Geachteter Ermittler",
      "text": "Ganz Kettlegate kennt deinen Namen. Marlowe überlässt dir ein eigenes Büro im hinteren Flügel des Reviers, mit Lagerschrank."
    }
  ],
