{
  "k2a_tinte": {
    "title": "Die Tinte des Telegrafisten",
    "kind": "side",
    "case": "k2a_tinte",
    "summary": "Nachts antwortet eine seit dreißig Jahren versunkene Station. Rimmel möchte wissen, wer am anderen Ende sitzt, bevor die Wache seinen Namen auf einen Steckbrief setzt.",
    "steps": [
      {
        "text": "Untersuche die erste Spur und sprich mit dem Auftraggeber.",
        "done": {
          "requires_clues": [
            "k2a_tinte_h_a1",
            "k2a_tinte_h_a2"
          ]
        },
        "target": {
          "map": "wx_bahnhof",
          "id": "k2a_tinte_ort_a1",
          "label": "Der Nachtstreifen"
        }
      },
      {
        "text": "Sichere den Zugang trotz der Grauspäherkontrolle.",
        "done": {
          "requires_flags": [
            "k2a_tinte_kontrolle_done"
          ]
        },
        "target": {
          "map": "wx_bahnhof",
          "id": "k2a_tinte_polizei",
          "label": "Kontrollstelle"
        }
      },
      {
        "text": "Prüfe Aussagen und Schriftstücke an den weiteren Schauplätzen.",
        "done": {
          "requires_clues": [
            "k2a_tinte_h_b1",
            "k2a_tinte_h_b2",
            "k2a_tinte_h_c1",
            "k2a_tinte_h_c2"
          ]
        },
        "target": {
          "map": "wx_bahnhof",
          "id": "k2a_tinte_ort_b1",
          "label": "Blankes Lötzinn"
        }
      },
      {
        "text": "Verbinde Tatablauf und Verantwortlichkeit im Notizbuch.",
        "done": {
          "requires_conclusions": [
            "k2a_tinte_d_leitung",
            "k2a_tinte_d_ware",
            "k2a_tinte_d_taeter"
          ]
        },
        "target": {
          "map": "wx_salzmarkt",
          "id": "k2a_senn",
          "label": "Ivo Senn"
        }
      },
      {
        "text": "Widerlege die Aussage im Verhör mit den gefundenen Belegen.",
        "done": {
          "requires_flags": [
            "k2a_tinte_gestellt"
          ]
        },
        "target": {
          "map": "wx_salzmarkt",
          "id": "k2a_senn",
          "label": "Ivo Senn"
        }
      },
      {
        "text": "Bestehe den Showdown. Eine Niederlage lässt die Akte offen.",
        "done": {
          "requires_flags": [
            "won_k2a_tinte_kampf"
          ]
        },
        "target": {
          "map": "wx_torfstich",
          "id": "k2a_tinte_finale",
          "label": "Leitungsverkäufer Ivo Senn"
        }
      },
      {
        "text": "Entscheide über Belege, Betroffene und Abschluss.",
        "done": {
          "requires_flags": [
            "k2a_tinte_done"
          ]
        },
        "target": {
          "map": "wx_torfstich",
          "id": "k2a_tinte_finale",
          "label": "Abschlussbericht"
        }
      }
    ]
  },
