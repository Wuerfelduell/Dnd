        ]
      }
    ],
    "nodes_add": {
      "koop_ds_reaktion_nellie": {
        "text": "Nellie blickt zwischen euch hin und her. „Ich trage keine Nachricht von einem Ärmel zum anderen.“",
        "choices": [
          {
            "text": "Wir sprechen miteinander.",
            "next": "koop_ds_reaktion_nellie_antwort",
            "requires_flags": [
              "koop_aktiv"
            ]
          },
          {
            "text": "Wir kommen später wieder."
          }
        ]
      },
      "koop_ds_reaktion_nellie_antwort": {
        "text": "„Gut. Dann bleiben meine Schuhe für längere Strecken übrig.“",
        "choices": [
          {
            "text": "Danke.",
            "next": "k3a_start"
          }
        ]
      }
    }
  },
  "k3a_huxford": {
    "choices_add": [
      {
        "text": "Sie bemerken meine Begleitung.",
        "next": "koop_ds_reaktion_huxford",
        "requires_flags": [
          "koop_aktiv"
        ]
      }
    ],
    "nodes_add": {
      "koop_ds_reaktion_huxford": {
        "text": "„Ihre Begleitung sieht ebenfalls müde aus. Das ist keine gemeinsame Diagnose.“",
        "choices": [
          {
            "text": "Sie dürfen uns einzeln fragen.",
            "next": "koop_ds_reaktion_huxford_antwort",
            "requires_flags": [
              "koop_aktiv"
            ]
          },
          {
            "text": "Wir kommen später wieder."
          }
        ]
      },
      "koop_ds_reaktion_huxford_antwort": {
        "text": "„Das hatte ich vor. Antworten Sie bitte nicht für die andere Person.“",
        "choices": [
          {
            "text": "Danke.",
            "next": "k3a_start"
          }
        ]
      }
    }
  },
  "k3a_esther": {
    "choices_add": [
      {
        "text": "Sie bemerken meine Begleitung.",
        "next": "koop_ds_reaktion_esther",
        "requires_flags": [
          "koop_aktiv"
        ]
      }
    ],
    "nodes_add": {
      "koop_ds_reaktion_esther": {
        "text": "Esther zieht das Buch näher. „Und der Name der zweiten Person? Für die Lohnliste.“",
        "choices": [
          {
            "text": "Wir tragen hier keinen von uns ein.",
            "next": "koop_ds_reaktion_esther_antwort",
            "requires_flags": [
              "koop_aktiv"
            ]
          },
          {
            "text": "Wir kommen später wieder."
          }
        ]
      },
      "koop_ds_reaktion_esther_antwort": {
        "text": "Die Feder bleibt trocken. „Dann notiere ich auch keinen Ersatznamen. Das wäre dieselbe Unhöflichkeit.“",
        "choices": [
          {
            "text": "Danke.",
            "next": "k3a_start"
          }
        ]
      }
    }
  },
  "k3a_adaine": {
    "choices_add": [
      {
        "text": "Sie bemerken meine Begleitung.",
        "next": "koop_ds_reaktion_adaine",
        "requires_flags": [
          "koop_aktiv"
        ]
      }
    ],
    "nodes_add": {
      "koop_ds_reaktion_adaine": {
        "text": "„Zwei Schatten auf meiner Messleine.“ Adaine hebt eine Hand. „Bleiben Sie bitte auf derselben Seite.“",
        "choices": [
          {
            "text": "Sonst stimmt das Maß nicht?",
            "next": "koop_ds_reaktion_adaine_antwort",
            "requires_flags": [
              "koop_aktiv"
            ]
          },
          {
            "text": "Wir kommen später wieder."
          }
        ]
      },
      "koop_ds_reaktion_adaine_antwort": {
        "text": "„Das Maß schon. Aber ich stolpere, wenn ich auf beide zugleich achten muss.“",
        "choices": [
          {
            "text": "Danke.",
            "next": "k3a_start"
          }
        ]
      }
    }
  },
  "k3p_hedda": {
    "choices_add": [
      {
        "text": "Sie bemerken meine Begleitung.",
        "next": "koop_ds_reaktion_hedda",
        "requires_flags": [
          "koop_aktiv"
        ]
      }
    ],
    "nodes_add": {
      "koop_ds_reaktion_hedda": {
        "text": "„Zwei Pfade, zwei Prüfungen. Ich nehme euch einzeln ab. Wer wartet, bleibt außerhalb der Anordnung.“",
        "choices": [
          {
            "text": "Und die Zutaten für den zweiten Pfad?",
            "next": "koop_ds_reaktion_hedda_antwort",
            "requires_flags": [
              "koop_aktiv"
            ]
          },
          {
            "text": "Wir kommen später wieder."
          }
        ]
      },
      "koop_ds_reaktion_hedda_antwort": {
        "text": "„Muss die zweite Person selbst erhalten. Ein bestandener Versuch und eine fremde Zutat ersetzen ihren Weg nicht.“",
        "choices": [
          {
            "text": "Danke.",
            "next": "k3p_start"
          }
        ]
      }
    }
  }
