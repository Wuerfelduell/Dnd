        },
        "target": {
          "map": "wx_salzmarkt",
          "id": "hesper",
          "label": "Hesper"
        }
      },
      {
        "text": "Bezahle Druce für die Hilfe.",
        "done": {
          "requires_flags": [
            "k2n_liste_druce"
          ]
        },
        "target": {
          "map": "wx_bahnhof",
          "id": "druce",
          "label": "Druce"
        }
      },
      {
        "text": "Bezahle Ruprecht Lamm für die Hilfe.",
        "done": {
          "requires_flags": [
            "k2n_liste_pedell"
          ]
        },
        "target": {
          "map": "wx_oberstadt",
          "id": "pedell",
          "label": "Ruprecht Lamm"
        }
      },
      {
        "text": "Kehre zu Zunder zurück und richte den Ofen ein.",
        "done": {
          "requires_flags": [
            "k2n_zunders_liste_done"
          ]
        },
        "target": {
          "map": "wx_kahn",
          "id": "zunder",
          "label": "Zunder"
        }
      }
    ]
  },
