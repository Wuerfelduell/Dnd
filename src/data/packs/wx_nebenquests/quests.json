  "k2n_moorkind": {
    "title": "Der Name hinter den Zähnen",
    "kind": "side",
    "case": "kapitel2",
    "summary": "Ein Kind ist aus dem Vergessmoor zurückgekommen, sein Name nicht. Stimme und Knotenzeichen können ihn wiederfinden, wenn du beide ernst nimmst.",
