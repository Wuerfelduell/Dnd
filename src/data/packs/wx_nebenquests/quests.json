        "text": "Entscheide mit Sedge und dem Kind über den Namen.",
        "done": {
          "requires_flags": [
            "k2n_moorkind_done"
          ]
        },
        "target": {
          "map": "wx_pfahldorf",
          "id": "sedge",
          "label": "Mutter Sedge"
        }
      }
    ]
  },
  "k2n_zunders_liste": {
    "title": "Drei Zeilen nach der Haft",
    "kind": "side",
    "case": "kapitel2",
