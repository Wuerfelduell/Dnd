{
  "k2n_reetdach": {
    "title": "Das Dach ohne Morgen",
    "kind": "side",
    "case": "kapitel2",
    "summary": "Ein Reetdecker verliert jede Nacht sein frisch verlegtes Dach. Mutter Sedge kennt einen Brauch, der Häusern ihre Adresse zurückgibt.",
    "steps": [
      {
        "text": "Untersuche die leere Kerbe am Türbalken.",
        "done": {
          "requires_clues": [
            "k2n_reet_kerbe"
          ]
        },
        "target": {
          "map": "wx_torfstich",
          "id": "k2n_reet_spur",
          "label": "Türbalken"
        }
      },
      {
        "text": "Frage Sedge nach einem Hausnamen.",
        "done": {
          "requires_flags": [
            "k2n_reet_brauch"
          ]
        },
        "target": {
          "map": "wx_pfahldorf",
          "id": "sedge",
          "label": "Mutter Sedge"
        }
      },
      {
        "text": "Erneuere das Täfelchen und beobachte das Dach.",
        "done": {
          "requires_flags": [
            "k2n_reet_gehalten"
          ]
        },
        "target": {
          "map": "wx_torfstich",
          "id": "k2n_reet_ritus",
          "label": "Reetdecker"
        }
      },
      {
        "text": "Entscheide bei Sedge, wer die Matten bekommt.",
        "done": {
          "requires_flags": [
            "k2n_reetdach_done"
          ]
        },
        "target": {
          "map": "wx_pfahldorf",
          "id": "sedge",
          "label": "Mutter Sedge"
        }
      }
    ]
  },
  "k2n_salzwaage": {
    "title": "Was vom Gewicht bleibt",
    "kind": "side",
    "case": "kapitel2",
    "summary": "Adas Eichgewichte werden täglich leichter. Hesper und Brack hatten Zugang, doch weder ein Gerücht noch ein Fluch ersetzt einen Wiegeversuch.",
    "steps": [
      {
        "text": "Prüfe Gewicht und Reparaturzettel.",
        "done": {
          "requires_clues": [
            "k2n_waage_salz",
            "k2n_waage_zettel"
          ]
        },
        "target": {
          "map": "wx_salzmarkt",
          "id": "k2n_waage_probe",
          "label": "Gewichtskasten"
        }
      },
      {
        "text": "Befrage Hesper.",
        "done": {
          "requires_clues": [
            "k2n_waage_hesper"
          ]
        },
        "target": {
          "map": "wx_salzmarkt",
          "id": "hesper",
          "label": "Hesper"
        }
      },
      {
        "text": "Befrage Brack.",
        "done": {
          "requires_clues": [
            "k2n_waage_brack"
          ]
        },
        "target": {
          "map": "wx_bojenhafen",
          "id": "brack",
          "label": "Brack"
        }
      },
      {
        "text": "Verbinde Salzverlust und Reparatur im Notizbuch.",
        "done": {
          "requires_conclusions": [
            "k2n_waage_schluss"
          ]
        },
        "target": {
          "map": "wx_salzmarkt",
          "id": "k2n_eichmeisterin",
          "label": "Ada Venn"
        }
      },
      {
        "text": "Entscheide über das öffentliche Protokoll.",
        "done": {
          "requires_flags": [
            "k2n_salzwaage_done"
          ]
        },
        "target": {
          "map": "wx_salzmarkt",
          "id": "k2n_eichmeisterin",
          "label": "Ada Venn"
        }
      }
    ]
  },
  "k2n_bojenlied": {
    "title": "Das Lied vom freien Platz",
    "kind": "side",
    "case": "kapitel2",
    "summary": "Ole Tamsen erkennt in drei Bojen ein altes Lied. Brack leiht dir ein Reserveboot, damit du seine fehlenden Zeilen findest.",
    "steps": [
      {
        "text": "Rudere zur Boje 1 und notiere ihren Takt.",
        "done": {
          "requires_clues": [
            "k2n_lied_1"
          ]
        },
        "target": {
          "map": "wx_bojenhafen",
          "id": "k2n_lied_boje1",
          "label": "Ruderfahrt 1"
        }
      },
      {
        "text": "Rudere zur Boje 2 und notiere ihren Takt.",
        "done": {
          "requires_clues": [
            "k2n_lied_2"
          ]
        },
        "target": {
          "map": "wx_bojenhafen",
          "id": "k2n_lied_boje2",
          "label": "Ruderfahrt 2"
        }
      },
      {
        "text": "Rudere zur Boje 3 und notiere ihren Takt.",
        "done": {
          "requires_clues": [
            "k2n_lied_3"
          ]
        },
        "target": {
          "map": "wx_bojenhafen",
          "id": "k2n_lied_boje3",
          "label": "Ruderfahrt 3"
        }
      },
      {
        "text": "Lies das zusammengesetzte Lied.",
        "done": {
          "requires_flags": [
            "k2n_lied_blatt_gelesen"
          ]
        },
        "target": {
          "map": "wx_bojenhafen",
          "id": "k2n_lied_blatt",
          "label": "Das Lied"
        }
      },
      {
        "text": "Entscheide bei Brack über die erste Weitergabe.",
        "done": {
          "requires_flags": [
            "k2n_bojenlied_done"
          ]
        },
        "target": {
          "map": "wx_bojenhafen",
          "id": "brack",
          "label": "Brack"
        }
      }
    ]
  },
  "k2n_falsches_gesicht": {
    "title": "Das absichtlich falsche Gesicht",
    "kind": "side",
    "case": "kapitel2",
    "summary": "Eine neue Oberstadtauflage zeigt dein Gesicht falsch. Der zivile Zeichner scheint darüber weniger überrascht als erleichtert.",
    "steps": [
      {
        "text": "Vergleiche Probedruck und Trauerbild.",
        "done": {
          "requires_clues": [
            "k2n_gesicht_druck"
          ]
        },
        "target": {
          "map": "wx_oberstadt",
          "id": "k2n_gesicht_druck",
          "label": "Probedruck"
        }
      },
      {
        "text": "Sprich Nils auf seinen Bruder an.",
        "done": {
          "requires_flags": [
            "k2n_gesicht_motiv"
          ]
        },
        "target": {
          "map": "wx_oberstadt",
          "id": "k2n_zeichner",
          "label": "Nils Feder"
        }
      },
      {
        "text": "Wähle Entlastung oder einen bleibenden Helfer.",
        "done": {
          "requires_flags": [
            "k2n_falsches_gesicht_done"
          ]
        },
        "target": {
          "map": "wx_oberstadt",
          "id": "k2n_zeichner",
          "label": "Nils Feder"
        }
      }
    ]
  },
  "k2n_kuestengift": {
    "title": "Was Jorin nach Hause folgt",
    "kind": "side",
    "case": "kapitel2",
    "summary": "Ein Student hält sich für verfolgt. Mit Akademierobe und einer echten Vergleichsprobe lässt sich prüfen, was seine Angst verursacht.",
    "steps": [
      {
        "text": "Nimm eine unbehandelte Probe im Salzwatt.",
        "done": {
          "requires_clues": [
            "k2n_gift_watt"
          ]
        },
        "target": {
          "map": "wx_salzwatt",
          "id": "k2n_gift_watt",
          "label": "Uferprobe"
        }
      },
      {
        "text": "Prüfe den Laborabfall in Akademierobe.",
        "done": {
          "requires_clues": [
            "k2n_gift_labor"
          ]
        },
        "target": {
          "map": "wx_akademie",
          "id": "k2n_gift_labor",
          "label": "Abfallbehälter"
        }
      },
      {
        "text": "Verbinde Tropfspur und Laborzusatz.",
        "done": {
          "requires_conclusions": [
            "k2n_gift_schluss"
          ]
        },
        "target": {
          "map": "wx_akademie",
          "id": "k2n_student",
          "label": "Jorin Siel"
        }
      },
      {
        "text": "Entscheide über die Veröffentlichung.",
        "done": {
          "requires_flags": [
            "k2n_kuestengift_done"
          ]
        },
        "target": {
          "map": "wx_akademie",
          "id": "k2n_student",
          "label": "Jorin Siel"
        }
      }
    ]
  },
  "k2n_pfandzettel": {
    "title": "Post für ein geschlossenes Büro",
    "kind": "side",
    "case": "kapitel2",
