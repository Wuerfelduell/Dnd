        "target": {
          "map": "wx_pfahldorf",
          "id": "k2n_kind_stimme",
          "label": "Kind am Geländer"
        }
      },
      {
        "text": "Vergleiche die Täfelchen oder beende die Suche auf Wunsch des Kindes.",
        "done": {
          "requires_flags": [
            "k2n_kind_spur_holz"
          ]
