     "k4_arrived",
     "cwa_akt1_done"
    ],
    "hide_if_flags": [
     "kapitel4_done",
     "cwa_akt2_done"
    ]
   },
   {
    "text": "Der Träger fragt jetzt zweimal, wem der Koffer gehört.",
