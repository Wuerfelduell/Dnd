     "k4_arrived",
     "cwa_akt4_done"
    ],
    "hide_if_flags": [
     "kapitel4_done"
    ]
   },
   {
    "text": "Ein voller Bahnsteig braucht keine amtliche Bestätigung.",
    "requires_flags": [
     "k4_arrived",
     "cwa_akt4_done"
    ],
    "hide_if_flags": [
     "kapitel4_done"
    ]
   }
  ],
  "cw_setzergasse": [
   {
    "text": "Die Presse nebenan hat mich geweckt, obwohl ich laut Hausbuch auswärts schlafe.",
