     {
      "text": "Wo kann ich anfangen?",
      "next": "sk_zusatz_marlowe_weg"
     },
     {
      "text": "Danke."
     }
    ]
   },
   "sk_zusatz_marlowe_weg": {
    "text": "„Frag Wenz Albrecht bei Glockengießerei Brannock. Dort kannst du die erste Spur prüfen.“",
    "choices": [
     {
      "text": "Ich nehme die Spur auf.",
      "next": "sk_zusatz_marlowe_annehmen",
      "hide_if_quests": [
       "sk_asche_kette"
      ]
     },
     {
      "text": "Ich sehe später nach."
     }
    ]
   },
   "sk_zusatz_marlowe_annehmen": {
    "text": "Du notierst den Ausgangspunkt der Untersuchung.",
    "start_quests": [
     "sk_asche_kette"
    ],
    "choices": [
     {
      "text": "Weiter."
     }
    ]
   }
  }
 },
