{
  "k3p_laterne_pruefung": {
    "title": "Das Licht unter dem Lack",
    "kind": "side",
    "case": "kapitel3",
    "summary": "„Ich sah früher Fehler überall, nur nicht in meinen eigenen Gutachten. Deine Laterne soll auch hinter dich leuchten.“ Finde beide Spuren und entscheide zwischen offener Gegenprobe und Kampf.",
    "steps": [
      {
        "text": "Untersuche die erste Spur.",
        "done": {
          "requires_flags": [
            "k3p_laterne_spur_a"
          ]
        },
        "target": {
          "map": "ds_kalkmarkt",
          "id": "k3p_laterne_spur_a",
          "label": "Das Licht unter dem Lack"
        }
      },
      {
        "text": "Prüfe den unabhängigen Gegenbeleg.",
        "done": {
          "requires_flags": [
            "k3p_laterne_spur_b"
          ]
        },
        "target": {
          "map": "ds_kalkmarkt",
          "id": "k3p_laterne_spur_b",
          "label": "Das Licht unter dem Lack"
        }
      },
      {
        "text": "Löse die Probe friedlich oder besiege den Hüter.",
        "done": {
          "requires_flags": [
            "k3p_laterne_bewaeltigt"
          ]
        },
        "target": {
          "map": "ds_kalkmarkt",
          "id": "k3p_laterne_probe",
          "label": "Lampengutachter"
        }
      },
      {
        "text": "Hole die Kernzutat bei Hedda ab.",
        "done": {
          "requires_flags": [
            "k3p_laterne_done"
          ]
        },
        "target": {
          "map": "ds_schwellenring",
          "id": "k3_weichenstellerin",
          "label": "Hedda Quist"
        }
      }
    ]
  },
