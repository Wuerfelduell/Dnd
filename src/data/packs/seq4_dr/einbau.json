  "gemeinsame_texte": {
    "s4r_solo": "Diese Prüfung legst du allein ab; dein Begleiter schaut zu.",
    "s4r_wiederholen": "Die Prüfung darf wiederholt werden, sobald du ihre Voraussetzungen wieder erfüllst.",
    "s4r_trank_frei": "Der Schwellenwächter ist besiegt; du darfst den Trank der Sequenz 4 trinken.",
    "s4r_ort_frei": "Kein fester Ritualort: Beginne dort, wo die Bedingungen deiner Prüfung erfüllt sind."
  },
  "offene_anschluesse": {
    "faden": "Die Vorgabe verlangt den verstärkten Traumkampf und einen abschließenden Wächter, legt dessen Lage zum Erwachen aber nicht eindeutig fest; der Einbau muss sie bestimmen, ohne Heilung im Traum freizugeben.",
    "maske": "Die Einschränkungen der Zivilistenprüfung sind verbindlich; ob sie auch im anschließenden Wächterkampf gelten, ist nicht ausdrücklich festgelegt und wird hier nicht erweitert.",
    "schluessel": "Die zufällige eigene Fähigkeit darf Heil- und Parierverbot nicht umgehen; Auswahlfilter beziehungsweise gesperrte Verwendung muss der Regelkern festlegen.",
    "laterne": "Kein Wechsel auf einen Kampfbildschirm, auch nicht für Sonnenaufgang; Fehlschlagbedingungen jenseits einer Niederlage werden hier nicht erfunden.",
    "koop_echo": "Die beiden Zuschauerzeilen nur vor Eintritt beziehungsweise nach Ende der Taubheit zeigen; währenddessen keine hörbare Rede an den Aufsteigenden.",
    "echo_waechter": "Sichttexte sind Atmosphäre, keine Angriffsvorwarnung; nicht an Angriffstiming koppeln.",
    "moor_eigenschaften": "Vorschlagspool: zufällige Übernahme an die fünf tatsächlichen Opfergegenstände binden, nicht beliebige zusätzliche Eigenschaften garantieren.",
    "wexmoor": "Kopfgelder als einmalige Ziele; Arbeiten wiederholbar, Funde erneut erbeutbar und beim Verkauf verbraucht; keine Auszahlung allein durch Dialogwiederholung."
  }
