{
  "k3o_schwellenhund_station": {
    "start": "k3o_start",
    "nodes": {
      "k3o_start": {
        "text": "Du stehst an der markierten Arbeitsstelle. Prüfe zuerst die örtliche Tafel; du kannst jederzeit umkehren.",
        "choices": [
          {
            "text": "Den falschen Anfahrpfiff am unbenutzten Gleis prüfen.",
            "next": "k3o_vorbereitung",
            "requires_flags": [
              "k3o_rangierwueste_gelesen1"
            ],
            "hide_if_flags": [
              "k3o_falscher_pfiff"
            ]
          },
          {
            "text": "Die vorbereitete stille Passage nutzen.",
            "next": "k3o_friedlich",
            "requires_flags": [
              "k3o_falscher_pfiff"
            ],
            "hide_if_flags": [
              "k3o_schwellenhund_geloest"
            ]
          },
          {
            "text": "Den Hüter herausfordern.",
            "next": "k3o_kampf",
            "hide_if_flags": [
              "k3o_schwellenhund_geloest"
            ]
          },
          {
            "text": "Zurück zum sicheren Weg."
          }
        ]
      },
      "k3o_vorbereitung": {
        "text": "Das Suchlicht folgt der falschen Anfahrt. Hinter der Mauer bleibt ein stiller Zugang zum Walzenfach.",
        "sets_flags": [
          "k3o_falscher_pfiff"
        ],
        "choices": [
          {
            "text": "Zurück.",
            "next": "k3o_start"
          }
        ]
      },
      "k3o_kampf": {
        "text": "Du trittst in den deutlich markierten Suchkreis. Die Angriffe werden vor jedem Treffer angekündigt.",
        "combat": "schwellenhund"
      },
      "k3o_friedlich": {
        "text": "Das Suchlicht folgt der falschen Anfahrt. Hinter der Mauer bleibt ein stiller Zugang zum Walzenfach. Die örtliche Aufgabe ist auch ohne Sieg im Kampf bewältigt.",
        "sets_flags": [
          "k3o_schwellenhund_geloest"
        ],
        "choices": [
          {
            "text": "Weiter.",
            "next": "k3o_start"
          }
        ]
      }
    }
  },
