      "start": {
        "text": "Der Schmuggler liegt auf den Planken und hält sich die Rippen. „Schon gut, schon gut! Was willst du?“",
        "choices": [
          {
            "text": "Wo legt die Königin an?",
            "next": "route",
            "requires_quests_active": [
              "kopfgeld_koenigin"
            ],
            "hide_if_flags": [
              "koenigin_route"
            ]
          },
          {
            "text": "Verschwinde."
          }
        ]
      },
      "route": {
        "text": "„Unter der dritten Brücke, wenn die Glocke vom Nordtor zwölf schlägt. Sie hat immer einen zweiten Kahn hinter dem Lagerhaus. Wenn du den losmachst, sitzt sie fest.“ Er spuckt aus. „Sag ihr nicht, dass ich es war.“",
        "sets_flags": [
          "koenigin_route"
        ],
