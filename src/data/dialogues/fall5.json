  "brannock": {
    "start": "start",
    "nodes": {
      "start": {
        "text": "Ein breiter Mann mit Lederschürze und versengten Augenbrauen wischt sich Ruß von den Händen. „Hugh Brannock. Die Gießerei ist zu. Seit einer Woche. Familienangelegenheit.“",
        "choices": [
          {
            "text": "Wer hat Ihre Öfen gemietet?",
            "next": "rost",
            "hide_if_clues": [
              "brannock_lady"
            ],
            "requires_quests_active": [
              "case_05"
            ]
          },
          {
            "text": "Hier steht „M. V.“ in Ihrem Auftragsbuch. Keine Rostbrüder.",
            "next": "lady",
            "requires_clues": [
              "ledger_mv"
            ],
            "hide_if_clues": [
              "brannock_lady"
            ],
            "requires_quests_active": [
              "case_05"
            ]
          },
          {
            "text": "Wo hängt die Glocke jetzt?",
            "next": "hour",
            "requires_clues": [
              "brannock_lady"
            ],
            "hide_if_clues": [
              "brannock_hour"
            ],
            "requires_quests_active": [
              "case_05"
            ]
          },
          {
            "text": "Was gießen Sie sonst?",
            "next": "trade"
          },
          {
            "text": "Schon gut."
          }
        ]
      },
      "rost": {
        "text": "Er sieht zur Seite. „Rostbrüder. Die mit den Ketten. Fragen Sie die.“ Seine Hand zittert, als er den Hammer weglegt. Er lügt, und er weiß, dass du es siehst.",
        "choices": [
          {
            "text": "Ich komme wieder.",
            "next": "start"
          }
        ]
      },
      "lady": {
        "text": "Brannock setzt sich schwer auf einen Amboss.",
        "gives_clues": [
          "brannock_lady"
        ],
        "choices": [
          {
            "text": "Weiter.",
            "next": "start"
          }
        ]
      },
      "hour": {
        "text": "„Ich hab sie gefragt, wozu eine Glocke unter der Erde gut ist. Sie hat gelacht und gesagt: damit die Toten sie zuerst hören.“",
        "gives_clues": [
          "brannock_hour"
        ],
        "sets_flags": [
          "kammer_known"
        ],
        "choices": [
          {
            "text": "Danke, Meister Brannock.",
            "next": "start"
          }
        ]
      },
      "trade": {
        "text": "„Kirchenglocken, Schiffsglocken, Türglocken. Dreihundert Jahre Brannock am Kanal. Und jetzt singt meine Grube nachts.“",
        "choices": [
          {
            "text": "Verstehe.",
            "next": "start"
          }
        ],
        "scene": "giessgrube"
      }
    }
  },
