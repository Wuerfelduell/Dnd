    "nodes": {
      "brief_01": {
        "text": "Sie sind also der Neue. Setzen Sie sich nicht, wir haben keine Zeit.\n\nEin Lampenanzünder, Elias Thorne, ist heute Nacht in Ashgrove Lane verschwunden. Constable Price hält es für einen Unfall. Ich nicht. Gehen Sie hin. Und glauben Sie nicht alles, was man Ihnen erzählt. Auch meinen eigenen Leuten nicht.",
        "sets_flags": [
          "briefed_01",
          "travel_ashgrove"
        ],
        "start_quests": [
          "case_01"
        ],
        "complete_quests": [
          "arrival"
        ],
        "choices": [
          {
            "text": "Was zählt hier im Revier?",
            "next": "about_honor"
          },
          {
            "text": "Ich mache mich auf den Weg."
          }
        ]
      },
      "about_honor": {
        "text": "Ihr Ruf. Lösen Sie Fälle sauber, stellen Sie Gauner, und Türen öffnen sich: Akten, Zeugen, meine Geduld. Beschuldigen Sie Unschuldige, und Sie stehen wieder auf der Straße.\n\nUnd noch etwas: Eine Aussage ist nur eine Vermutung. Erst wenn eine zweite Quelle dasselbe sagt, glaube ich es.",
        "choices": [
          {
            "text": "Verstanden.",
            "next": "hub"
          }
        ]
      },
      "report_good": {
        "text": "Elias Thorne lebt. Gute Arbeit, wirklich.\n\nVey. Diesen Namen habe ich seit zwölf Jahren nicht mehr gehört.",
        "sets_flags": [
          "reported_01"
        ],
        "complete_quests": [
          "report_01"
        ],
        "choices": [
          {
            "text": "Sie kennen sie?",
            "next": "brief_02"
          }
        ]
      },
      "report_bad": {
        "text": "Elias Thorne ist tot. Das Revier vergisst so etwas nicht, und ich auch nicht.\n\nTrotzdem: Ich brauche jeden, der denken kann.",
        "sets_flags": [
          "reported_01"
        ],
        "complete_quests": [
          "report_01"
        ],
        "choices": [
          {
            "text": "Was gibt es?",
            "next": "brief_02"
          }
        ]
      },
      "brief_02": {
        "text": "Später. Es gibt Neues: Hester Marsh, vierzehn, ist verschwunden. Am selben Morgen fand der Küster von St. Ebba ein geöffnetes Kindergrab.\n\nConstable Rook meint, das Mädchen sei einfach weggelaufen. Prüfen Sie das.",
        "gives_clues": [
          "police_runaway"
        ],
        "sets_flags": [
          "travel_ebba",
          "briefed_02"
        ],
        "start_quests": [
          "case_02"
        ],
        "choices": [
          {
            "text": "Ich sehe mir die Ruine an."
          }
        ]
      },
      "hub": {
        "text": "Ja?",
        "choices": [
          {
            "text": "Wie stehe ich im Revier?",
            "next": "standing"
          },
          {
            "text": "Haben Sie einen Rat für mich?",
            "next": "advice"
          },
          {
            "text": "Was wissen Sie über Miriam Vey?",
            "next": "secret",
            "requires_quests_active": [
              "case_02"
            ],
            "requires_honor": 50,
            "hide_if_clues": [
              "marlowe_secret"
            ]
          },
          {
            "text": "Jemand hat das Augen-Siegel in Barnabys Zellengitter geritzt. Von außen.",
            "next": "cell",
            "requires_clues": [
              "cell_sigil"
            ],
            "hide_if_flags": [
              "cell_reported"
            ]
          },
          {
            "text": "Ich weiß, was mit Hester geschehen ist.",
            "next": "accuse",
            "requires_quests_active": [
              "case_02"
            ]
          },
          {
            "text": "Nichts weiter."
          }
        ]
      },
      "standing": {
        "rank": true,
        "text": "Marlowe mustert dich.",
        "choices": [
          {
            "text": "Danke.",
            "next": "hub"
          }
        ]
      },
      "advice": {
        "hint": true,
        "text": "Hm.",
        "choices": [
          {
            "text": "Danke.",
            "next": "hub"
          }
        ]
      },
      "secret": {
        "text": "Ich war damals dabei, als junge Constable. Als St. Ebba brannte, hat Miriam Vey nicht geweint. Sie hat gesungen. Und gesagt: Jedes Licht, das ich nehme, bringt dich ein Stück zurück.\n\nSie meinte ihre Tochter Lilian.",
        "gives_clues": [
          "marlowe_secret"
        ],
        "choices": [
          {
            "text": "Danke für Ihr Vertrauen.",
            "next": "hub"
          }
        ]
      },
      "cell": {
        "text": "Von außen? Dann war es einer von uns.\n\nDas bleibt unter uns, verstanden? Kein Wort zu den Constables. Danke.",
        "sets_flags": [
          "cell_reported"
        ],
        "complete_quests": [
          "cell_knock"
        ],
        "choices": [
          {
            "text": "Kein Wort.",
            "next": "hub"
          }
        ]
      },
      "accuse": {
        "text": "Ich höre.",
        "choices": [
          {
            "text": "Hester ist weggelaufen, wie Constable Rook sagt.",
            "next": "end_runaway"
          },
          {
            "text": "Küster Anselm steckt dahinter.",
            "next": "end_anselm"
          },
          {
            "text": "Moll hat für Vey das Grab geöffnet, und Veys Lied hat Hester in die Krypta gelockt. Sie liegt dort unten.",
            "requires_conclusions": [
              "grave_for_vey",
              "lured_by_vey"
            ],
            "requires_flags": [
              "hester_found"
            ],
            "next": [
              {
                "node": "end_good",
                "requires_certain": [
                  "grave_for_vey",
                  "lured_by_vey"
                ]
              },
              {
                "node": "unsure"
              }
            ]
          },
          {
            "text": "Mehr noch: Vey wollte mit Hesters Leben ihre Tochter Lilian zurückholen. Ich habe die Spieldose zerstört.",
            "requires_conclusions": [
              "grave_for_vey",
              "lured_by_vey",
              "vey_motive"
            ],
            "requires_flags": [
              "hester_found",
              "box_destroyed"
            ],
            "next": [
              {
                "node": "end_perfect",
                "requires_certain": [
                  "grave_for_vey",
                  "lured_by_vey",
                  "vey_motive"
                ]
              },
              {
                "node": "unsure"
              }
            ]
          },
          {
            "text": "Noch nicht.",
            "next": "hub"
          }
        ]
      },
      "unsure": {
        "text": "Vermutungen. Ich brauche Informationen, die mindestens zwei Quellen bestätigen. Kommen Sie wieder, wenn Sie sicher sind.",
        "choices": [
          {
            "text": "Verstanden.",
            "next": "hub"
          }
        ]
      },
      "end_runaway": {
        "text": "Marlowe seufzt und schließt die Akte.",
        "ending": "c2_runaway"
      },
      "end_anselm": {
        "text": "Marlowe schickt zwei Constables los.",
        "ending": "c2_anselm"
      },
      "end_good": {
        "text": "Marlowe ist schon aufgestanden, bevor du fertig bist. „Holt, vier Mann, Laternen. Sofort.“",
        "ending": "c2_good"
      },
      "end_perfect": {
        "text": "Marlowe sieht dich lange an. Dann greift sie selbst nach ihrem Mantel.",
        "ending": "c2_perfect"
      },
      "epilogue": {
        "text": "Vey ist noch da draußen. Und jemand in diesem Revier ritzt Augen in meine Gitter.\n\nRuhen Sie sich aus, Ermittler. Der nächste Fall kommt bestimmt.\n\n(Ende von Fall 2. Fall 3 folgt.)",
        "choices": [
          {
            "text": "Wie stehe ich im Revier?",
            "next": "standing"
          },
          {
            "text": "Gute Nacht, Inspektorin."
          }
        ]
      }
    }
  },
