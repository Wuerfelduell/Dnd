  "holt": {
    "start": "start",
    "nodes": {
      "start": {
        "text": "Sergeant Holt, Wachhabender. Was gibt's?",
        "choices": [
          {
            "text": "Wie bekomme ich hier Ansehen?",
            "next": "honor"
          },
          {
            "text": "Haben Sie einen Tipp für mich?",
            "next": "tip"
          },
          {
            "text": "Wie gut kennen Sie Constable Rook?",
            "next": "rook",
            "requires_clues": [
              "cell_sigil"
