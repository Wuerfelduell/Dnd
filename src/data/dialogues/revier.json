      "honor": {
        "text": "Fälle lösen. Gauner stellen. Nicht lügen und keinen Falschen beschuldigen. Wer oben steht, sieht mehr Akten und bekommt mehr Antworten. Lesen Sie die Dienstvorschriften da hinten am Regal.",
        "choices": [
          {
            "text": "Danke.",
            "next": "start"
          }
        ]
      },
      "tip": {
        "hint": true,
        "text": "Lassen Sie mich überlegen ...",
        "choices": [
          {
            "text": "Danke.",
            "next": "start"
          }
        ]
      },
      "rook": {
        "text": "Rook? Neu hier. Kam vor einem halben Jahr aus der alten Kapellengemeinde von St. Ebba. Fleißig, immer als Erster da und als Letzter weg. Wieso fragen Sie?",
        "choices": [
          {
            "text": "Nur so.",
            "next": "start"
          }
        ]
      },
      "spar_intro": {
        "text": "Verteidigen? In Kettlegate? Kluger Gedanke. Hören Sie zu:\n\nWenn einer ausholt, sehen Sie einen Ring auf sich zukommen. Leertaste, und Sie weichen aus. Das klappt fast immer. F, und Sie parieren. Das ist schwerer, das Fenster ist eng. Aber wer pariert, sammelt Konzentration und schlägt sofort zurück. Wer alle Schläge pariert, setzt zum Gegenschlag an.\n\nUnd wenn Sie selbst zuschlagen: im richtigen Moment drücken, dann trifft es richtig. Konzentration brauchen Sie für Fertigkeiten. Zeigen Sie mal.",
        "choices": [
          {
            "text": "Auf geht's.",
            "next": "spar_go"
          },
          {
            "text": "Ein andermal.",
            "next": "start"
          }
        ]
      },
      "spar_go": {
        "text": "Holt stellt sich breitbeinig hin. „Keine Sorge, ich halte mich zurück.“",
        "combat": "sparring",
        "choices": [
          {
            "text": "(Kampf beginnen)"
          }
        ]
      },
      "spar_again": {
        "text": "Immer gern. Die Knochen werden nicht jünger, aber meine Fäuste schon gar nicht.",
        "choices": [
          {
            "text": "Los.",
            "next": "spar_go"
          },
          {
            "text": "Lieber nicht.",
            "next": "start"
          }
        ]
      },
      "gear": {
        "text": "Hilfsermittler, ja? Dann steht Ihnen ein Schlagstock zu. Und ein Verband, falls Sie ihn ins Gesicht bekommen. Unterschreiben Sie hier.",
        "gives_items": {
          "schlagstock": 1,
          "verband": 1
        },
        "sets_flags": [
          "got_gear"
        ],
        "choices": [
          {
            "text": "Danke, Sergeant.",
            "next": "start"
          }
        ]
      }
    }
  },
