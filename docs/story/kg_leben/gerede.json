{
  "kettlegate": {
    "altmarkt": [
      {
        "text": "Der Kastanienmann zählt heute mit Handschuhen.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Almas Laken trocknen schneller als der Aushang.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Waage steht schief, der Händler steht dazu.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Am Brunnen tauschen sie Knöpfe gegen Nachrichten.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Hafenakte ist zu, die Gerüchte haben geöffnet.",
        "requires_flags": [
          "case_03_closed"
        ],
        "hide_if_flags": [
          "case_06_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Pip verkauft jetzt auch die Berichtigungen ordentlich gefaltet.",
        "requires_flags": [
          "case_03_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_06_closed"
        ]
      },
      {
        "text": "Seit der Spiegelakte hängt ein Tuch am Friseurfenster.",
        "requires_flags": [
          "case_06_closed"
        ],
        "hide_if_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Alma wäscht heute die Vorhänge der Garderoben.",
        "requires_flags": [
          "case_06_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_09_closed"
        ]
      },
      {
        "text": "Neun Akten später kostet die Miete noch dasselbe.",
        "requires_flags": [
          "case_09_closed"
        ],
        "hide_if_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Heute bleibt ein Fenster für Heimkehrer hell.",
        "requires_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      }
    ],
    "ashgrove": [
      {
        "text": "Oren klopft vor dem Anzünden an jede Leiter.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Im Rinnstein schwimmt ein leerer Teebeutel wie ein Frachter.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Rike hat auf dem Dach eine verlorene Mütze gefunden.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Der Hund schläft dort, wo die Steine noch warm sind.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Seit der Hafenakte schaut jeder Bote auf die Hausnummer.",
        "requires_flags": [
          "case_03_closed"
        ],
        "hide_if_flags": [
          "case_06_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Edda geht heute mit einem leeren Korb heim.",
        "requires_flags": [
          "case_03_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_06_closed"
        ]
      },
      {
        "text": "Die Spiegelgeschichte macht die Fenster nicht sauberer.",
        "requires_flags": [
          "case_06_closed"
        ],
        "hide_if_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Rike sagt, auch ein gewöhnlicher Schatten brauche Licht.",
        "requires_flags": [
          "case_06_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_09_closed"
        ]
      },
      {
        "text": "Nach der Sternwarte hat Oren alle Dochte gewechselt.",
        "requires_flags": [
          "case_09_closed"
        ],
        "hide_if_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Steckbriefe hängen schief. Der Regen liest trotzdem mit.",
        "requires_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      }
    ],
    "docks": [
      {
        "text": "Mara verkauft nach Gewicht, der Nebel nach Gefühl.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Möwen kennen den Ladenschluss besser als ich.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Der Heißwassermann hat heute zwei heile Tassen.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Ein Tau schlägt seit Stunden gegen denselben Poller.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Seit der Hafenakte bleibt die Lagertür offen.",
        "requires_flags": [
          "case_03_closed"
        ],
        "hide_if_flags": [
          "case_06_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Mara fragt wieder nach dem Fang statt nach Uniformen.",
        "requires_flags": [
          "case_03_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_06_closed"
        ]
      },
      {
        "text": "Im Kanal spiegelt sich genug, seit der sechsten Akte.",
        "requires_flags": [
          "case_06_closed"
        ],
        "hide_if_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Bootsleute decken nachts ihre blanken Eimer zu.",
        "requires_flags": [
          "case_06_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_09_closed"
        ]
      },
      {
        "text": "Nach der Sternwarte prüft jeder den Himmel vor dem Wasser.",
        "requires_flags": [
          "case_09_closed"
        ],
        "hide_if_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Möwe hat einen Steckbrief zum Nest erklärt.",
        "requires_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      }
    ],
    "ebba": [
      {
        "text": "Edda faltet die Tücher mit dem Saum nach innen.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Tauben halten vor der Kapelle keine Andacht.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Am Tor wartet ein Mann mit Blumen aus Papier.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Die leere Schale wurde frisch ausgewaschen.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Seit der Hafenakte kommen weniger Fragen und mehr Besucher.",
        "requires_flags": [
          "case_03_closed"
        ],
        "hide_if_flags": [
          "case_06_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Edda schreibt Namen aus, auch wenn die Zeile eng wird.",
        "requires_flags": [
          "case_03_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_06_closed"
        ]
      },
      {
        "text": "Nach der Spiegelakte bleiben die Waschschalen bedeckt.",
        "requires_flags": [
          "case_06_closed"
        ],
        "hide_if_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Ein Angehöriger hat den Spiegel zur Wand gedreht.",
        "requires_flags": [
          "case_06_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_09_closed"
        ]
      },
      {
        "text": "Nach neun Akten bleibt hier für jeden ein Name.",
        "requires_flags": [
          "case_09_closed"
        ],
        "hide_if_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Kerzen sind kurz, aber jemand hat neue bestellt.",
        "requires_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      }
    ],
    "nordtor": [
      {
        "text": "Jost bürstet sein Pferd gegen den Strich der Stadt.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Nikos Uhr geht vor, seine Mittagspause geht nach.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Knopf kennt jeden, der Brot in der Tasche trägt.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Bram prüft die Tür zweimal und zählt kein Publikum.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Seit der Hafenakte klopft Jost auch an leere Wagen.",
        "requires_flags": [
          "case_03_closed"
        ],
        "hide_if_flags": [
          "case_06_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Der Lehrling nennt die dritte Akte eine schwere Feder.",
        "requires_flags": [
          "case_03_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_06_closed"
        ]
      },
      {
        "text": "Seit der Spiegelakte ist die Garderobe verhängt.",
        "requires_flags": [
          "case_06_closed"
        ],
        "hide_if_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Bram trägt die Laterne tiefer als früher.",
        "requires_flags": [
          "case_06_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_09_closed"
        ]
      },
      {
        "text": "Nach der Sternwarte fährt Jost wieder die lange Strecke.",
        "requires_flags": [
          "case_09_closed"
        ],
        "hide_if_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Knopf erkennt Gesichter ohne die neuen Aushänge.",
        "requires_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      }
    ],
    "nachtmarkt": [
      {
        "text": "Die Orgel findet ihren vierten Takt heute nicht.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Mara nimmt die Waage nachts mit nach Hause.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Der Affe schläft auf einem Tuch, das teurer als die Orgel ist.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Alma tauscht eine trockene Schürze gegen Tee.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Hafenakte ist zu, hier wird trotzdem leise gesprochen.",
        "requires_flags": [
          "case_03_closed"
        ],
        "hide_if_flags": [
          "case_06_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Pip faltet die alten Nachrichten zu Spitztüten.",
        "requires_flags": [
          "case_03_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_06_closed"
        ]
      },
      {
        "text": "Seit der Spiegelakte verkauft niemand polierte Deckel.",
        "requires_flags": [
          "case_06_closed"
        ],
        "hide_if_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Orgel braucht keinen Schatten zum Spielen.",
        "requires_flags": [
          "case_06_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_09_closed"
        ]
      },
      {
        "text": "Nach der Sternwarte fragen sie öfter nach Heimwegen.",
        "requires_flags": [
          "case_09_closed"
        ],
        "hide_if_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Unter der Brücke bleibt für müde Leute eine Bank frei.",
        "requires_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      }
    ],
    "tavern": [
      {
        "text": "Rike setzt sich immer mit Abstand zum sauberen Vorhang.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Niko legt seine Uhr neben den Teller und wartet auf beide.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Der Wirt trocknet Gläser mit einem stillen Tuch.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Die letzte Suppe bekommt heute der Fahrer.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Seit der Hafenakte lässt man Uniformen länger an der Tür warten.",
        "requires_flags": [
          "case_03_closed"
        ],
        "hide_if_flags": [
          "case_06_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Pip hat die dritte Akte mit einem Suppenfleck gelesen.",
        "requires_flags": [
          "case_03_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_06_closed"
        ]
      },
      {
        "text": "Nach der Spiegelakte wurde der Wandschmuck verhängt.",
        "requires_flags": [
          "case_06_closed"
        ],
        "hide_if_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Ein Gast bestellt einen zweiten Teller für keinen Schatten.",
        "requires_flags": [
          "case_06_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_09_closed"
        ]
      },
      {
        "text": "Neun Akten machen noch keinen freien Tisch.",
        "requires_flags": [
          "case_09_closed"
        ],
        "hide_if_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Oren legt die Leiter draußen ab und den Tag gleich dazu.",
        "requires_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      }
    ],
    "ankerhof": [
      {
        "text": "Der Prediger muss gegen ein klapperndes Rad anreden.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Ein Arbeiter sammelt Nägel, die andere liegenlassen.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Spendendose klingt hohl und sehr überzeugt.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Am Brunnen wird ein Sandeimer ausgebessert.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Seit der Hafenakte will jeder Redner eine Quittung zeigen.",
        "requires_flags": [
          "case_03_closed"
        ],
        "hide_if_flags": [
          "case_06_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Zuhörer stellen seit dem dritten Fall kürzere Fragen.",
        "requires_flags": [
          "case_03_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_06_closed"
        ]
      },
      {
        "text": "Nach der Spiegelakte gelten blanke Schilder als unfein.",
        "requires_flags": [
          "case_06_closed"
        ],
        "hide_if_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Der Prediger hat seinen Spiegel abgehängt, das Schild bleibt.",
        "requires_flags": [
          "case_06_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_09_closed"
        ]
      },
      {
        "text": "Nach der Sternwarte bleibt am Rednerpult ein Platz leer.",
        "requires_flags": [
          "case_09_closed"
        ],
        "hide_if_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Heute reden die Arbeiter über Dächer statt über Wunder.",
        "requires_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      }
    ],
    "theater": [
      {
        "text": "Bram prüft den Hintereingang vor dem Vorhang.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Ein Requisitenhut trocknet auf einer umgedrehten Tasse.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Garderobennummern fehlen immer paarweise.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Hinter der Bühne riecht es nach kalter Schminke.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Seit der Hafenakte werden Kisten vor Zeugen geöffnet.",
        "requires_flags": [
          "case_03_closed"
        ],
        "hide_if_flags": [
          "case_06_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Bram zählt nach dem dritten Fall lieber die Schlüssel.",
        "requires_flags": [
          "case_03_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_06_closed"
        ]
      },
      {
        "text": "Seit der Spiegelakte schaut niemand lange in die Garderobe.",
        "requires_flags": [
          "case_06_closed"
        ],
        "hide_if_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Die verhängten Spiegel bekommen heute frische Tücher.",
        "requires_flags": [
          "case_06_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_09_closed"
        ]
      },
      {
        "text": "Nach der Sternwarte probt die Truppe wieder gewöhnliche Abgänge.",
        "requires_flags": [
          "case_09_closed"
        ],
        "hide_if_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Bram hebt die Laterne für den letzten Heimweg.",
        "requires_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      }
    ],
    "sternwarte": [
      {
        "text": "An der Dachkante hängt eine Fledermaus wie ein verlorener Handschuh.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Die Stufen tragen Staub von vielen gewöhnlichen Schuhen.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Ein Fensterhaken schlägt gegen Messing.",
        "hide_if_flags": [
          "case_03_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Der Wind findet jede Fuge im Kuppelrand.",
        "hide_if_flags": [
          "case_03_closed"
        ],
        "requires_flags": [
          "k3h_nacht"
        ]
      },
      {
        "text": "Nach der Hafenakte schauen Besucher häufiger hinter Türen.",
        "requires_flags": [
          "case_03_closed"
        ],
        "hide_if_flags": [
          "case_06_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Die dritte Akte steht unten in der Zeitung, hier liegt Staub.",
        "requires_flags": [
          "case_03_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_06_closed"
        ]
      },
      {
        "text": "Seit der Spiegelakte sind blanke Linsen weniger beruhigend.",
        "requires_flags": [
          "case_06_closed"
        ],
        "hide_if_flags": [
          "case_09_closed",
          "k3h_nacht"
        ]
      },
      {
        "text": "Ein Tuch über dem Glas macht die Fragen nicht kleiner.",
        "requires_flags": [
          "case_06_closed",
          "k3h_nacht"
        ],
        "hide_if_flags": [
          "case_09_closed"
        ]
