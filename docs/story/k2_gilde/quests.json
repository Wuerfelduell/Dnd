          "map": "wx_torfstich",
          "id": "k2g_name_torf",
          "label": "Schubkarrengriff"
        }
      },
      {
        "text": "Sichere den Namen unter der Werkbank im Pfahldorf.",
        "done": {
          "requires_clues": [
            "k2g_name_pfahl"
          ]
