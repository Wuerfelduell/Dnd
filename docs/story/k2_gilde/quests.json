          "requires_clues": [
            "k2g_name_watt"
          ]
        },
        "target": {
          "map": "wx_salzwatt",
          "id": "k2g_name_watt",
          "label": "Doppelte Schale"
        }
      },
      {
        "text": "Bring Sedge die Abschriften und bestimme, wie sie bewahrt werden.",
        "done": {
          "requires_flags": [
            "k2g_aufnahme_done"
          ]
        },
        "target": {
          "map": "wx_pfahldorf",
          "id": "sedge",
          "label": "Mutter Sedge"
        }
      }
    ]
