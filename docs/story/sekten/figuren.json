          ]
        },
        "gruss_mittel": {
          "text": "„Dein Schritt ist bekannt. Deine Stimme fehlt noch.“",
          "choices": [
            {
              "text": "Ich möchte etwas wissen.",
              "next": "hub"
            },
            {
              "text": "Später.",
              "next": "abschied"
            }
          ]
        },
        "gruss_hoch": {
          "text": "„Eine angesehene Stimme erreicht viele Türen. Denk darüber nach.“",
          "choices": [
            {
              "text": "Ich möchte etwas wissen.",
              "next": "hub"
            },
            {
              "text": "Später.",
              "next": "abschied"
            }
          ]
        },
        "hub": {
          "text": "Was möchtest du ansprechen?",
          "choices": [
            {
              "text": "Deine Arbeit.",
              "next": "thema"
            },
            {
              "text": "Mein Pfad.",
              "next": "pfad",
              "requires_pathway": [
                "echo",
                9
              ]
            },
            {
              "text": "Was kann ich tun?",
              "next": "hilfe"
            },
            {
              "text": "Ich gehe.",
              "next": "abschied"
            }
          ]
        },
        "thema": {
          "text": "„Ich prüfe, ob eine Schicht gemeinsam antworten kann. Einzelne Rufe gehen im Lärm verloren.“",
          "choices": [
            {
              "text": "Noch etwas.",
              "next": "hub"
            },
            {
              "text": "Leb wohl.",
              "next": "abschied"
            }
          ]
        },
        "pfad": {
          "text": "„Ein Echo kennt keinen Widerspruch. Vielleicht ist das seine beste Eigenschaft.“",
          "choices": [
            {
              "text": "Noch etwas.",
              "next": "hub"
            },
            {
              "text": "Leb wohl.",
              "next": "abschied"
            }
          ]
        },
        "hilfe": {
          "text": "„Rike hat den Einsatz verweigert. Hör dir an, was sie damit gewonnen hat.“",
          "choices": [
            {
              "text": "Danke.",
              "next": "hub"
            },
            {
              "text": "Ich mache mich auf den Weg.",
              "next": "abschied"
            }
          ]
        },
        "abschied": {
          "text": "„Achte auf den Rückweg.“",
          "choices": [
            {
              "text": "Gespräch beenden."
            }
          ]
        }
      }
    },
