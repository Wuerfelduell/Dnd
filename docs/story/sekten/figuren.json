            {
              "text": "Ich möchte etwas wissen.",
              "next": "hub"
            },
            {
              "text": "Später.",
              "next": "abschied"
            }
          ]
        },
        "gruss_mittel": {
          "text": "„Du hast wenigstens zugehört. Hier ist seine letzte Nachricht.“",
          "choices": [
            {
              "text": "Ich möchte etwas wissen.",
              "next": "hub"
            },
            {
              "text": "Später.",
              "next": "abschied"
            }
          ]
        },
        "gruss_hoch": {
          "text": "„Wenn man dir Türen öffnet, such bitte hinter der warmen.“",
          "choices": [
            {
              "text": "Ich möchte etwas wissen.",
              "next": "hub"
            },
            {
              "text": "Später.",
              "next": "abschied"
            }
          ]
        },
        "hub": {
          "text": "Was möchtest du ansprechen?",
          "choices": [
            {
              "text": "Deine Arbeit.",
              "next": "thema"
            },
            {
              "text": "Mein Pfad.",
              "next": "pfad",
              "requires_pathway": [
                "eisen",
                9
