  "dialogues": {
    "sk_asche_sprecher_ida": {
      "start": [
        {
          "node": "gruss_hoch",
          "requires_honor": 40
        },
        {
          "node": "gruss_mittel",
          "requires_honor": 10
        },
        {
          "node": "gruss_niedrig"
        }
      ],
      "nodes": {
        "gruss_niedrig": {
          "text": "„Du kommst spät. Für deine Akte ist vielleicht noch Platz.“",
          "choices": [
            {
              "text": "Ich möchte etwas wissen.",
              "next": "hub"
            },
            {
              "text": "Später.",
              "next": "abschied"
            }
          ]
        },
        "gruss_mittel": {
          "text": "„Man kennt dich. Das muss nicht immer ein Vorteil sein.“",
          "choices": [
            {
              "text": "Ich möchte etwas wissen.",
              "next": "hub"
            },
            {
              "text": "Später.",
              "next": "abschied"
            }
          ]
        },
        "gruss_hoch": {
          "text": "„So viel Ansehen, und doch trägst du noch deinen Namen.“",
          "choices": [
            {
              "text": "Ich möchte etwas wissen.",
              "next": "hub"
            },
            {
              "text": "Später.",
              "next": "abschied"
            }
          ]
        },
        "hub": {
          "text": "Was möchtest du ansprechen?",
          "choices": [
            {
              "text": "Deine Arbeit.",
              "next": "thema"
            },
            {
              "text": "Mein Pfad.",
              "next": "pfad",
              "requires_pathway": [
                "eisen",
                9
              ]
            },
            {
              "text": "Was kann ich tun?",
              "next": "hilfe"
            },
            {
              "text": "Ich gehe.",
              "next": "abschied"
            }
          ]
        },
        "thema": {
          "text": "„Ich halte die Feuer gleichmäßig. Namen brennen ungleich; manche brauchen Hilfe.“",
          "choices": [
            {
              "text": "Noch etwas.",
              "next": "hub"
            },
            {
              "text": "Leb wohl.",
              "next": "abschied"
            }
          ]
        },
        "pfad": {
          "text": "„Eisen hält einen Ofen zusammen. Es hält auch Menschen dort, wo andere sie haben wollen.“",
          "choices": [
            {
              "text": "Noch etwas.",
              "next": "hub"
            },
            {
              "text": "Leb wohl.",
              "next": "abschied"
            }
          ]
        },
        "hilfe": {
          "text": "„Tobin kennt die kalten Stellen unserer Arbeit. Wenn du zweifelst, geh zu ihm.“",
          "choices": [
            {
              "text": "Danke.",
              "next": "hub"
            },
            {
              "text": "Ich mache mich auf den Weg.",
              "next": "abschied"
            }
          ]
        },
        "abschied": {
          "text": "„Achte auf den Rückweg.“",
          "choices": [
            {
              "text": "Gespräch beenden."
            }
          ]
        }
      }
    },
    "sk_asche_aussteiger_tobin": {
      "start": [
        {
          "node": "gruss_hoch",
          "requires_honor": 40
        },
        {
          "node": "gruss_mittel",
          "requires_honor": 10
        },
        {
          "node": "gruss_niedrig"
        }
      ],
      "nodes": {
        "gruss_niedrig": {
          "text": "„Bleib im Licht. Ich sehe deine Hände nicht.“",
          "choices": [
            {
              "text": "Ich möchte etwas wissen.",
              "next": "hub"
            },
            {
              "text": "Später.",
              "next": "abschied"
            }
          ]
        },
        "gruss_mittel": {
          "text": "„Du fragst erst. Das haben sie sich abgewöhnt.“",
          "choices": [
            {
              "text": "Ich möchte etwas wissen.",
              "next": "hub"
            },
            {
              "text": "Später.",
              "next": "abschied"
            }
          ]
        },
        "gruss_hoch": {
          "text": "„Wenn dein Wort etwas gilt, versprich niemandem Reinigung.“",
          "choices": [
            {
              "text": "Ich möchte etwas wissen.",
              "next": "hub"
            },
            {
              "text": "Später.",
              "next": "abschied"
            }
          ]
        },
        "hub": {
          "text": "Was möchtest du ansprechen?",
          "choices": [
            {
              "text": "Deine Arbeit.",
              "next": "thema"
            },
            {
              "text": "Mein Pfad.",
              "next": "pfad",
              "requires_pathway": [
                "eisen",
                9
              ]
            },
            {
              "text": "Was kann ich tun?",
              "next": "hilfe"
            },
            {
              "text": "Ich gehe.",
              "next": "abschied"
            }
          ]
        },
        "thema": {
          "text": "„Ich habe meinen Namen verbrannt. Die Schulden fanden mich trotzdem. Nur meine Freunde suchten länger.“",
          "choices": [
            {
              "text": "Noch etwas.",
              "next": "hub"
            },
            {
              "text": "Leb wohl.",
              "next": "abschied"
            }
          ]
        },
        "pfad": {
          "text": "„Eisen kann die Glut halten. Aber zum Löschen brauchst du etwas, das du auch wieder loslassen kannst.“",
          "choices": [
            {
              "text": "Noch etwas.",
              "next": "hub"
            },
            {
              "text": "Leb wohl.",
              "next": "abschied"
            }
          ]
        },
        "hilfe": {
          "text": "„Für Läuterwasser breche ich das Siegel über einer kalten Glutkohle. Das Wasser bindet nur ihre falsche Hitze. Gegen gewöhnliches Feuer hilft es nicht.“",
          "sets_flags": [
            "sk_asche_rezept"
          ],
          "choices": [
            {
              "text": "Danke.",
              "next": "hub"
            },
            {
              "text": "Ich mache mich auf den Weg.",
              "next": "abschied"
            }
          ]
        },
        "abschied": {
          "text": "„Achte auf den Rückweg.“",
          "choices": [
            {
              "text": "Gespräch beenden."
            }
          ]
        }
      }
    },
    "sk_asche_opfer_wenz": {
      "start": [
        {
          "node": "gruss_hoch",
          "requires_honor": 40
        },
        {
          "node": "gruss_mittel",
