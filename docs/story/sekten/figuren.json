            {
              "text": "Was kann ich tun?",
              "next": "hilfe"
            },
            {
              "text": "Ich gehe.",
              "next": "abschied"
            }
          ]
        },
        "thema": {
          "text": "„Mein Bruder sollte seine Schande loswerden. Seitdem bekommt ein anderer seinen Lohn.“",
          "choices": [
            {
              "text": "Noch etwas.",
              "next": "hub"
            },
            {
              "text": "Leb wohl.",
              "next": "abschied"
            }
          ]
        },
        "pfad": {
          "text": "„Eisen hört nicht zu. Du schon, hoffe ich.“",
          "choices": [
            {
              "text": "Noch etwas.",
              "next": "hub"
            },
            {
              "text": "Leb wohl.",
              "next": "abschied"
            }
          ]
        },
        "hilfe": {
          "text": "„Fang bei der kalten Aktenmulde an. Ich will ihn zurück, nicht eine saubere Geschichte.“",
          "start_quests": [
            "sk_asche_kette"
          ],
          "choices": [
            {
              "text": "Danke.",
              "next": "hub"
            },
            {
              "text": "Ich mache mich auf den Weg.",
              "next": "abschied"
            }
          ]
        },
        "abschied": {
          "text": "„Achte auf den Rückweg.“",
          "choices": [
            {
              "text": "Gespräch beenden."
            }
          ]
        }
      }
    },
