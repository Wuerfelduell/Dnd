{
  "varrowmouth": {
    "vm_zollhafen": [
      {
        "id": "k6_cx_gerede_allgemein_01",
        "text": "Die Pegeluhr geht richtig. Der Ratskalender hat größere Freiheiten.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_04",
        "text": "Der zweite Zeiger ist neu. Niemand hat ihn bestellt.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_07",
        "text": "Auf der Oberstraße bezahlt man für trockene Schuhe mit nassen Unterschriften.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_10",
        "text": "Ressa näht Säume so, dass sie morgen höher sitzen können.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_13",
        "text": "Tebb wartet auf ein Schiff, dessen Name niemand kennt.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_16",
        "text": "Hester hat den Stempel abgelegt und die Brille aufgesetzt.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_19",
        "text": "Der Reisende aus Kettlegate poliert eine Delle aus seinem Koffer.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_01",
        "text": "Jetzt sieht man, wem gestern ein Löffel fehlte.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_04",
        "text": "Tam hat gelacht. Die Pegeluhr bestätigt den Anlass.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_07",
        "text": "Nell prüft die Steine mit dem Absatz.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_10",
        "text": "Am Wrack liegt ein Fenster, das nie ein Haus gesehen hat.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_13",
        "text": "Unter dem Marktsteg hängt noch die Kreide von gestern.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_16",
        "text": "Die freie Gasse ist kein Versprechen für den Rückweg.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_19",
        "text": "Der Schlick nimmt Abdrücke an, ohne nach Papieren zu fragen.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_01",
        "text": "Der Markt schwimmt nicht. Er knarrt nur überzeugend.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_04",
        "text": "Dessa hat die Tassen auf dem oberen Steg ausgepackt.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_07",
        "text": "Ressa hat die Schere an den Mantel gebunden.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_10",
        "text": "Die Kantine ist um eine Treppe nach oben gezogen.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_13",
        "text": "Osric wartet am Zollhaus mit einem eingewickelten Glas.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_16",
        "text": "Auf der Oberstraße hört man das Wasser durch geschlossene Fenster.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_19",
        "text": "Bessa zählt die losen Planken vom Geländer aus.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_wrackmutter_01",
        "text": "Am Wrack lassen sich die Leinen wieder einzeln lösen.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_wrackmutter_besiegt"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_wrackmutter_04",
        "text": "Ein besiegtes Wrack wird nicht automatisch ein sicherer Boden.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_wrackmutter_besiegt"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_wrackmutter_07",
        "text": "Die Fischer reden wieder über den Fang statt über Schritte im Rumpf.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_wrackmutter_besiegt"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_wrackmutter_10",
        "text": "Am Markt verkauft niemand das Wrackholz als Glücksbringer. Noch nicht.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_wrackmutter_besiegt"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_leuchtfeuer_01",
        "text": "Das alte Licht fällt wieder gleichmäßig über die Bank.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_leuchtfeuer_befreit"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_leuchtfeuer_04",
        "text": "Der Fährmann prüft den Lichtwinkel an seinem Ruder.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_leuchtfeuer_befreit"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_leuchtfeuer_07",
        "text": "Im Zollhaus werden die Abschriften plötzlich langsam gelesen.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_leuchtfeuer_befreit"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_leuchtfeuer_10",
        "text": "Tam legt eine Reserveleine ins Boot. Für die nächste Frage.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_leuchtfeuer_befreit"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      }
    ],
    "vm_stegviertel": [
      {
        "id": "k6_cx_gerede_allgemein_02",
        "text": "Im Zollhaus trocknet Papier schneller als ein Mantel.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_05",
        "text": "Marda wiegt auch den Korb. Wenigstens sagt sie es vorher.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_08",
        "text": "Der Schreiber antwortet leserlicher als der Rat.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_11",
        "text": "Pell hat mehr leeres Papier bestellt als der ganze Hafen.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_14",
        "text": "Rusk stellt ihre Tasse nie auf einen schiefen Tisch.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_17",
        "text": "Jorin zählt Schüsseln. Damit kommt er erstaunlich weit.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_20",
        "text": "Der Kurgast hat das einzige brauchbare Sitzkissen am Steg.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_02",
        "text": "Die unterste Treppe hat wieder sechs Stufen.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_05",
        "text": "Der Kielraum riecht nach Tee und offenem Holz.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_08",
        "text": "Ressa legt die langen Säume auf die trockene Schwelle.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_11",
        "text": "Die unteren Zolltüren gehen schwerer auf als die oberen.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_14",
        "text": "Die Hafenkähne liegen schief und tun so, als gehöre sich das.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_17",
        "text": "Auf der Pegellatte sitzen Krähen unter der roten Marke.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_20",
        "text": "Wer jetzt hinuntergeht, sollte vorher zur Uhr hinaufsehen.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_02",
        "text": "Die unterste Treppe gehört wieder den Fischen.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_05",
        "text": "Aus den Schlickgassen sieht nur noch die Dachkante heraus.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_08",
        "text": "Die Taucherin lässt heute den schweren Helm stehen.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_11",
        "text": "Der Wasserspiegel reicht bis an die alte Gebührenmarke.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_14",
        "text": "Die Pegeluhr braucht keine nassen Zeugen.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_17",
        "text": "Der Wrackzugang ist fort. Die Gewohnheit zu spät umzudrehen bleibt.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_20",
        "text": "Die Tafel des Schreibers hat heute einen trockenen Rahmen.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_wrackmutter_02",
        "text": "Dessa prüft den Kielraum, bevor sie die erste Tasse hinstellt.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_wrackmutter_besiegt"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_wrackmutter_05",
        "text": "Tam hat den Zugang mit gewöhnlichem Tau markiert.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_wrackmutter_besiegt"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_wrackmutter_08",
        "text": "Aus dem Wrack kommt kein fremdes Wiegen mehr. Das Holz arbeitet noch.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_wrackmutter_besiegt"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_leuchtfeuer_02",
        "text": "Osric hat einen Docht gewechselt und sich dann hingesetzt.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_leuchtfeuer_befreit"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_leuchtfeuer_05",
        "text": "Eine freie Leuchtbank bleibt bei schlechtem Pegel eine Sandbank.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_leuchtfeuer_befreit"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_leuchtfeuer_08",
        "text": "Rusk vergleicht die Anzeige mit dem Licht am Horizont.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_leuchtfeuer_befreit"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      }
    ],
    "vm_oberstrasse": [
      {
        "id": "k6_cx_gerede_allgemein_03",
        "text": "Tam verlangt Platz für ein Seil, nicht für einen Stammbaum.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_06",
        "text": "Die Kantine hat zwei Kessel und nur einen geraden Deckel.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_09",
        "text": "Dessas Tassen passen nicht zusammen. Sie halten trotzdem dicht.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_12",
        "text": "Voss liest leere Zeilen besonders lange.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_15",
        "text": "Bessa prüft Nägel, bevor sie Reden anhört.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_allgemein_18",
        "text": "Die Apothekenflaschen stehen höher als die guten Weingläser.",
        "requires_flags": [
          "k6_arrived"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_03",
        "text": "Im Schlick stehen Namen, die keine Hand geschrieben hat.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_06",
        "text": "Die Fischkörbe stehen heute eine Sprosse tiefer.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_09",
        "text": "Die Taucherin zählt Schlauchstücke statt Münzen.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_12",
        "text": "Der Fährmann hat sein Boot mit einer längeren Leine festgemacht.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_15",
        "text": "Osric wischt Salz vom Sockel des Leuchtfeuers.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_ebbe_18",
        "text": "Man kann bis zur nächsten Pfütze die eigenen Schuhe hören.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_ebbe"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_03",
        "text": "Tam lacht nicht mehr. Sie zieht die Knoten nach.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_06",
        "text": "Nell sitzt dort, wo die Kreide trocken bleibt.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_09",
        "text": "Der Fährmann steigt jetzt über die Bank ein.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_12",
        "text": "Die Zollglocke klingt von unten, obwohl sie oben hängt.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_15",
        "text": "Mardas letzter Fischkorb hängt am höchsten Haken.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_flut_18",
        "text": "Die Laternen spiegeln sich doppelt, die Wege werden weniger.",
        "requires_flags": [
          "k6_arrived",
          "gezeit_flut"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_wrackmutter_03",
        "text": "Die Taucherin verlangt weiterhin eine zweite Hand am Schlauch.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_wrackmutter_besiegt"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_wrackmutter_06",
        "text": "Nell geht nicht allein zwischen die Spanten. Ressa besteht darauf.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_wrackmutter_besiegt"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_wrackmutter_09",
        "text": "Der Rat nennt es eine geborgene Gefahrenstelle. Der Bericht bleibt sehr kurz.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_wrackmutter_besiegt"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_leuchtfeuer_03",
        "text": "Die Glocke hängt still. Man hört sie trotzdem noch in den Zähnen.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_leuchtfeuer_befreit"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_leuchtfeuer_06",
        "text": "Hester hat nach dem alten Protokoll gefragt, nicht nach einer Feier.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_leuchtfeuer_befreit"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      },
      {
        "id": "k6_cx_gerede_leuchtfeuer_09",
        "text": "Der Mechaniker hat die zweite Skala nicht mehr verdeckt.",
        "requires_flags": [
          "k6_arrived",
          "k6_cx_leuchtfeuer_befreit"
        ],
        "hide_if_flags": [
          "k6_done"
        ]
      }
    ]
  }
}
