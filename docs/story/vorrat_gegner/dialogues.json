            "text": "Weiter."
          }
        ]
      },
      "quittung": {
        "text": "Der Platz des Händlers ist leer. Seine Wegegarantie braucht ihr nicht.",
        "choices": [
          {
            "text": "Weiter."
          }
        ]
      }
    }
  }
}
