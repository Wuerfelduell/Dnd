    "nodes": {
      "start": {
        "text": "„Garantiert der richtige Weg“, ruft der Händler. Sein Beutel ist verschnürt, das angebliche Amtssiegel noch weich.",
        "choices": [
          {
            "text": "Die Garantie vor dem Kauf prüfen.",
            "next": "pruefen"
          },
          {
            "text": "Die Drohung zurückweisen und kämpfen.",
            "next": "kampf"
          },
          {
            "text": "Ohne Kauf weitergehen.",
            "next": "gehen"
          }
        ]
      },
      "pruefen": {
        "text": "Der Beutel ist leer. „Die Garantie ist geistiger Art“, sagt er und zieht den Verschluss hastig zu.",
        "choices": [
          {
            "text": "Ich kaufe nichts. Lass die anderen Reisenden gehen.",
            "next": "entlarvt"
          },
          {
            "text": "Du bedrohst uns nicht weiter.",
            "next": "kampf"
          },
          {
            "text": "Das genügt mir.",
            "next": "gehen"
          }
        ]
      },
      "entlarvt": {
        "text": "Er schiebt den Beutel unter den Mantel und flieht. Eure Geldbörse bleibt geschlossen.",
        "sets_flags": [
          "vg_all_marktschreier_geloest"
        ],
        "choices": [
          {
            "text": "Weiter."
          }
        ]
      },
      "kampf": {
        "text": "Er nimmt den Vorführstock. Ihr könnt ihn entwaffnen; ein Kampf endet mit seiner Flucht.",
        "combat": "vg_all_marktschreier",
        "choices": []
      },
      "gehen": {
        "text": "Ihr geht ohne Kauf. Es wird kein Geld abgezogen und keine Verfolgung ausgelöst.",
