[
  {
    "id": "haus_gerede_01",
    "text": "Die Maklerin verkauft keine Schlösser. Nur Türen, die schließen.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_02",
    "text": "Sechshundert? Dafür muss der Keller aber trocken sein.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_03",
    "text": "Der Keller ist mitgereist? Nein, bloß die Kisten.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_04",
    "text": "Ich erkenne den Sessel durchs Fenster. Der stand vorher anderswo.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_05",
    "text": "Ein leeres Bildergestell ist auch eine Entscheidung.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_06",
    "text": "Der zweite Schreibtisch bleibt nicht immer leer.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_07",
    "text": "Da wird Tee gekocht, kein Verhör vorbereitet.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_08",
    "text": "Abends kommt manchmal Besuch. Immer nur einer.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_09",
    "text": "Wer eingeladen wird, muss nicht gleich einen Auftrag mitbringen.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_10",
    "text": "Die Glocke an der Wand läutet nie ungefragt.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_11",
    "text": "Man hat mir gesagt, die Akten bleiben im Arbeitszimmer. Meistens.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_12",
    "text": "Sogar eine welke Blume haben sie mitgenommen.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_13",
    "text": "Die Möbel haben mehr Bahnhöfe gesehen als ich.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_14",
    "text": "Ein Glas steht jetzt vor jeder Trophäe. Gegen den Staub, heißt es.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_15",
    "text": "Die Träger kennen inzwischen jede Kerbe der Truhe.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_16",
    "text": "Der Teppich liegt in jeder Stadt ein wenig schief.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_17",
    "text": "Zwei Betten sind noch lange kein Gasthaus.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_18",
    "text": "Die Haustür hat ein Schild ohne Rang und Amt.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_19",
    "text": "Wer heimkommt, muss nicht sofort erklären, wo er war.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": null
  },
  {
    "id": "haus_gerede_20",
    "text": "Ich hoffe, das Tier findet den neuen Sonnenfleck.",
    "requires_flags": [
      "haus_owned"
    ],
    "requires_package": "DF"
  }
]
