    {
      "id": "haus_gast_holt",
      "npc_id": "holt",
      "name": "Sergeant Holt",
      "city": "kettlegate",
      "condition": {
        "relation": {
          "holt": 4
        },
        "requires_flags": [
          "haus_owned",
          "haus_eingeladen_holt"
        ],
        "period": "abend",
        "npc_available": true,
        "same_city": true
      },
      "invitation": {
        "text": "Kommen Sie abends auf einen Tee vorbei.",
        "set_flag": "haus_eingeladen_holt",
        "requires_relation": 4
      },
      "dialogue": {
        "start": "start",
        "nodes": {
          "start": {
            "lines": [
              "Holt hängt den Mantel so auf, dass die Tür frei bleibt.",
              "„Ein guter Raum hat einen Ausgang, den man auch müde findet.“",
              "Du räumst einen Platz am Tisch frei.",
              "Draußen zieht ein Schritt an der Tür vorbei.",
              "Für einen Moment muss niemand anfangen."
            ],
            "choices": [
              {
                "id": "tee",
                "text": "Tee anbieten.",
                "next": "tee"
              },
              {
                "id": "geschichte",
                "text": "Nach einer Geschichte fragen.",
                "next": "geschichte"
              },
              {
                "id": "fall",
                "text": "Eine Frage zum Fall stellen.",
                "next": "fall"
              }
            ]
          },
          "tee": {
            "lines": [
              "Du gießt langsam ein.",
              "„So ist es gut. Wir müssen den Abend nicht füllen.“",
              "Ihr lasst die Tassen eine Weile zwischen euch stehen."
            ],
            "next": "ende"
          },
          "geschichte": {
            "lines": [
              "Du fragst nach etwas, das in keiner Akte steht.",
              "Sein erster Nachtposten endete mit einem verlorenen Stiefel im Kanal.",
              "Ihr lacht leise über die Einzelheit, die sonst niemand aufgeschrieben hätte."
            ],
            "next": "ende"
          },
          "fall": {
            "lines": [
              "Du schlägst nur die Seite auf, die du bereits kennst.",
              "„Schreiben Sie auf, was Sie gesehen haben. Den Rest dürfen Sie morgen prüfen.“",
              "Du markierst eine offene Frage, ohne eine neue Tatsache daraus zu machen."
            ],
            "next": "ende"
          },
          "ende": {
            "lines": [
              "Sergeant Holt legt ein kleines Mitbringsel neben die Tasse.",
              "An der Tür bleibt ein freundlicher Abschied, kein neuer Auftrag."
            ],
            "gift_once": {
              "item": "verband",
              "count": 1,
              "flag": "haus_geschenk_holt"
            },
            "sets_flags": [
              "haus_besuch_holt"
            ]
          }
        }
      },
      "gift": {
        "item": "verband",
        "count": 1,
        "once_per_campaign": true
      },
      "integration": {
        "relation_key": "holt",
        "add_relation_entry_if_missing": false
