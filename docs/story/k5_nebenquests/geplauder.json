    "requires_flags": [
      "k5_arrived",
      "koop_aktiv",
      "bha_ventil_glasgaerten_warm"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Die Falter wählen Wärme, keine Partei.“",
        "b": "„Die gewöhnlichen Nachtfalter reagieren auf den Zustand des Gartens.“"
      },
      {
        "p": "p1",
        "text": "„Nicht mit Glasmotten verwechseln.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_21",
    "map": "bh_stillenhaeuser",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv",
      "bhn_wintervorrat_koop_besprochen"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Vier Türen, viermal klopfen.“",
        "b": "„Jeder Haushalt braucht ein eigenes Gespräch.“"
      },
      {
        "p": "p1",
        "text": "„Keine Sammelunterschrift.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_22",
    "map": "bh_wurzelkranz",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Ein Ausstieg radiert keine Rechnung.“",
        "b": "„Der heutige Entschluss verändert das Datum des früheren Handels nicht.“"
      },
      {
        "p": "p1",
        "text": "„Wir halten beides getrennt fest.“"
      }
    ],
    "requires_quests_done": [
      "bhn_frachtbelege"
    ]
  },
  {
    "id": "bhn_geplauder_23",
    "map": "bh_mutterhaus",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Eine Rente macht den Strich nicht jünger.“",
        "b": "„Die spätere Zahlung widerlegt die alte Datierung nicht.“"
      },
      {
        "p": "p1",
        "text": "„Aber sie erklärt das Schweigen.“"
      }
    ],
    "requires_quests_done": [
      "bhn_wurzelzeichnungen"
    ]
  },
  {
    "id": "bhn_geplauder_24",
    "map": "bh_winterpromenade",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Heute dürfen die Leute selbst den letzten Satz schreiben.“",
        "b": "„Ein persönlicher Gruß muss nicht der Klinikvorlage folgen.“"
      },
      {
        "p": "p1",
        "text": "„Auch ein unvollständiger Satz darf hinaus.“"
      }
    ],
    "requires_quests_done": [
      "bhn_postkarten"
    ]
  }
]
