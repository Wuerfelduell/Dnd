[
  {
    "id": "bhn_geplauder_01",
    "map": "bh_kutschenhof",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv",
      "bhn_gepaeckschein_koop_besprochen"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Die Koffer haben mehr Etiketten als die Menschen.“",
        "b": "„Die Gepäckstücke sind genauer bezeichnet als ihre Besitzer.“"
      },
      {
        "p": "p1",
        "text": "„Ein Etikett kann nicht widersprechen.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_02",
    "map": "bh_kutschenhalle",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Ich lese nur das Siegel.“",
        "b": "„Ich beschränke mich auf das äußere Absendersiegel.“"
      },
      {
        "p": "p1",
        "text": "„Der Rest braucht eine Erlaubnis.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_03",
    "map": "bh_winterpromenade",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Diese Karte kenne ich, ohne sie gelesen zu haben.“",
        "b": "„Die Grußformel wiederholt sich auffällig.“"
      },
      {
        "p": "p1",
        "text": "„Die Rückseite ist noch frei.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_04",
    "map": "bh_pavillon",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Eine Pause ist auch ein Stück Musik.“",
        "b": "„Der freie Takt muss nicht von uns ausgefüllt werden.“"
      },
      {
        "p": "p1",
        "text": "„Dann lassen wir ihn frei.“"
      }
    ],
    "requires_quests_done": [
      "bhn_kurkonzert"
    ]
  },
  {
    "id": "bhn_geplauder_05",
    "map": "bh_kesselgrund",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv",
      "bhn_waermeschwarz_koop_besprochen"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Die Leitung ist warm. Mehr weiß ich nicht.“",
        "b": "„Temperatur allein sagt nichts über den Rücklauf.“"
      },
      {
        "p": "p1",
        "text": "„Wir lesen beide Anzeigen.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_06",
    "map": "bh_buegelraum",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Die Lüftung bleibt offen.“",
        "b": "„Die Türrolle darf den Lüftungsspalt nicht verschließen.“"
      },
      {
        "p": "p1",
        "text": "„Frost hat es zweimal gesagt.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_07",
    "map": "bh_glasgaerten",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Die Kresse sieht erfreulich gewöhnlich aus.“",
        "b": "„Dieser Topf benötigt offenbar nur Licht und Wasser.“"
      },
      {
        "p": "p1",
        "text": "„Lassen wir es dabei.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_08",
    "map": "bh_verkaufshalle",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Ich drehe kein Schild aus Neugier um.“",
        "b": "„Eine lesbare Beschriftung ist noch keine Erlaubnis zur Einsicht.“"
      },
      {
        "p": "p1",
        "text": "„Wir fragen Adeline.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_09",
    "map": "bh_stillenhaeuser",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Hier darf man hoffentlich auch schlecht schlafen.“",
        "b": "„Eine unruhige Nacht darf keine Pflichtbehandlung begründen.“"
      },
      {
        "p": "p1",
        "text": "„Wir fragen, was die Person möchte.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_10",
    "map": "bh_speisesaal",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Rübensuppe ohne Vergangenheit.“",
        "b": "„Ada verwendet gewöhnliche Zutaten.“"
      },
      {
        "p": "p1",
        "text": "„Die Erinnerung ans Fleisch gehört ihr.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_11",
    "map": "bh_wurzelkranz",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Leere Kisten sind mir lieber als volle Versprechen.“",
        "b": "„Wir prüfen zunächst die Verpackung und die Datierung.“"
      },
      {
        "p": "p1",
        "text": "„Keine versiegelte Sendung öffnen.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_12",
    "map": "bh_mutterhaus",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Der falsche Strich bleibt sichtbar.“",
        "b": "„Die erste Fassung erklärt die spätere Berichtigung.“"
      },
      {
        "p": "p1",
        "text": "„Beide gehören ins Heft.“"
      }
    ],
    "requires_quests_done": [
      "bhn_wurzelzeichnungen"
    ]
  },
  {
    "id": "bhn_geplauder_13",
    "map": "bh_aktenraum",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Ein Nein wird nicht alt.“",
        "b": "„Ein Widerruf bleibt auch neben einer früheren Zustimmung gültig.“"
      },
      {
        "p": "p1",
        "text": "„Dann legen wir ihn zum Original.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_14",
    "map": "bh_labor",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Diese Werbung lässt viel Platz fürs Kleingedruckte.“",
        "b": "„Die behauptete Wirkung ist genauer beschrieben als ihr Preis.“"
      },
      {
        "p": "p1",
        "text": "„Wir suchen die ausgelassenen Folgen.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_15",
    "map": "bh_pavillon",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Der leere Stuhl ist keine Einladung zum Verhör.“",
        "b": "„Eine freie Sitzgelegenheit begründet keine Gesprächspflicht.“"
      },
      {
        "p": "p1",
        "text": "„Wir warten auf eine Antwort.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_16",
    "map": "bh_kutschenhof",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Ein Paket reist allein besser als wir.“",
        "b": "„Der Absender ist nicht mit der Sendung eingetroffen.“"
      },
      {
        "p": "p1",
        "text": "„Wir bleiben bei seinem Brief.“"
      }
    ],
    "requires_quests_done": [
      "bhn_brief_aus_calderwick"
    ]
  },
  {
    "id": "bhn_geplauder_17",
    "map": "bh_kesselgrund",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Ich halte die Lampe. Nicht den Hahn.“",
        "b": "„Ich sichere nur die Beleuchtung, bis die Schaltung bestätigt ist.“"
      },
      {
        "p": "p1",
        "text": "„So bleibt der Zustand unverändert.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_18",
    "map": "bh_buegelraum",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv",
      "bhn_schraubenschluessel_koop_besprochen"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Der Schlüssel braucht kein Familienbild.“",
        "b": "„Die Werkzeugkerbe reicht für diese Reparatur aus.“"
      },
      {
        "p": "p1",
        "text": "„Frost muss nichts erinnern.“"
      }
    ]
  },
  {
    "id": "bhn_geplauder_19",
    "map": "bh_speisesaal",
    "requires_flags": [
      "k5_arrived",
      "koop_aktiv"
    ],
    "zeilen": [
      {
        "p": "p2",
        "a": "„Die Glocke ist jetzt erreichbar.“",
        "b": "„Der Gast kann den neuen Platz selbst erproben.“"
      },
      {
        "p": "p1",
        "text": "„Wir greifen nicht für ihn hin.“"
      }
    ],
    "requires_quests_done": [
      "bhn_namensheft"
    ]
  },
  {
    "id": "bhn_geplauder_20",
