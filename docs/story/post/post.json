  "notizbuch": [
    {
      "id": "post_notizbuch_kettlegate",
      "stadt": "kettlegate",
      "text": "Du kannst Post am Schalter, im Büro oder im freigeschalteten Haus abholen. Alle drei zeigen dasselbe Fach."
