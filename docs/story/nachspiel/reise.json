  "ereignisse": [
    {
      "id": "np_bahn_fenster",
      "text": "Du wischst einen schmalen Streifen im beschlagenen Fenster frei. Dahinter laufen Zäune rückwärts. Niemand im Abteil verlangt eine Erklärung für dein Ziel."
    },
    {
      "id": "np_bahn_personal",
      "text": "Oren hält ein frisch geprüftes Kupplungsstück gegen das Licht. „Eigene Leitung, eigene Wagen“, sagt er. „Die Küstenbahn ist kein Ersatzdienst für die alte Anlage.“ Er legt das Stück zurück in seine Werkzeugtasche.",
      "npc": "k3_oren",
      "when_city": "dunscar"
    },
    {
      "id": "np_bahn_tee",
      "text": "Der Tee riecht schwächer, als seine Farbe verspricht. Du hältst den Becher mit beiden Händen. Zwischen zwei Halten wird er endlich trinkbar."
    },
    {
      "id": "np_bahn_knopf",
      "text": "Ein Knopf rollt unter die Bank. Du schiebst ihn mit der Schuhspitze in den Gang. Eine Hand hebt ihn auf; der Besitzer nickt und näht weiter."
    },
    {
      "id": "np_bahn_durchschlag",
      "text": "Der Schaffner prüft den Durchschlag deiner Fahrkarte. Ein Buchstabe ist verrutscht. Er fragt nach deinem Ziel und berichtigt ihn, ohne einen zweiten Namen zu verlangen."
    },
    {
      "id": "np_bahn_licht",
      "text": "Am letzten Fenster des Wagens flackert das Licht. Dann brennt es wieder gleichmäßig. Du siehst eine leere Bank und die gewöhnlichen Kratzer in ihrem Holz."
    }
  ],
