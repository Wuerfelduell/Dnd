      "koop_ds_horchen_annahme": {
        "text": "„Beim Horchen bleibt einer am Trichter und einer am Hinterzugang. Bei der Schleuse hält immer jemand innen den Hebel.“",
        "choices": [
          {
            "text": "Weiter."
