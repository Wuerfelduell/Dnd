      }
    ],
    "nodes": {
      "koop_ds_horchen_start": {
        "text": "Ein Ruf kostet eine Ladung. Spieler 1 bedient den Trichter; Spieler 2 beobachtet den Hinterzugang.",
        "choices": [
          {
            "text": "Den Depotpfiff senden. Eine Ladung.",
            "next": "koop_ds_horchen_gesendet",
            "requires_flags": [
              "koop_aktiv",
              "koop_ds_horchen_angenommen",
              "koop_ds_horchen_p1",
              "koop_ds_horchen_p2"
            ],
            "requires_signal_charge": true,
            "hide_if_flags": [
              "koop_ds_horchen_fertig"
            ]
          },
          {
            "text": "Kostenlos horchen.",
            "next": "koop_ds_horchen_horchen"
          },
          {
            "text": "Zu Pfiff zurück. Nachfüllen ist kostenlos."
          }
        ]
      },
      "koop_ds_horchen_horchen": {
        "text": "Das Rohr bleibt still. Ohne Ladung könnt ihr weiter horchen oder zu Pfiff gehen. Der öffentliche Fußweg bleibt frei.",
        "choices": [
          {
            "text": "Weiter."
          }
        ]
      },
      "koop_ds_horchen_gesendet": {
        "text": "Der Pfiff läuft aus dem Trichter. Spieler 2 prüft die sichtbare Antwort am Hinterzugang.",
        "choices": [
          {
            "text": "Spieler 2 liest die Antwort.",
            "next": "koop_ds_horchen_beobachtung",
            "requires_flags": [
              "koop_aktiv",
              "koop_ds_horchen_angenommen",
              "koop_ds_horchen_p1",
              "koop_ds_horchen_p2"
            ]
          }
        ],
        "signal": "call",
        "sets_flags": [
          "koop_ds_horchen_ruf_laeuft"
        ]
      },
      "koop_ds_horchen_beobachtung": {
        "text": "Nur Spieler 2 liest: Der Lichtstrich endet östlich des Trichters an der Hintertür. Teilt die Richtung mit.",
        "choices": [
          {
            "text": "Spieler 1 wählt die gemeldete Richtung.",
            "next": "koop_ds_horchen_wahl",
            "requires_flags": [
              "koop_aktiv",
              "koop_ds_horchen_angenommen",
              "koop_ds_horchen_p1",
              "koop_ds_horchen_p2",
              "koop_ds_horchen_ruf_laeuft"
            ]
          }
        ]
      },
      "koop_ds_horchen_wahl": {
        "text": "Spieler 1: Aus welcher Richtung kam die Antwort am Hinterzugang?",
        "choices": [
          {
            "text": "Norden.",
            "next": "koop_ds_horchen_fehl",
            "requires_flags": [
              "koop_aktiv",
              "koop_ds_horchen_angenommen",
              "koop_ds_horchen_p1",
              "koop_ds_horchen_p2",
              "koop_ds_horchen_ruf_laeuft"
            ]
          },
          {
            "text": "Osten.",
            "next": "koop_ds_horchen_erfolg",
            "requires_flags": [
              "koop_aktiv",
              "koop_ds_horchen_angenommen",
              "koop_ds_horchen_p1",
              "koop_ds_horchen_p2",
              "koop_ds_horchen_ruf_laeuft"
            ],
            "hide_if_flags": [
              "koop_ds_horchen_fertig"
            ]
          },
          {
            "text": "Westen.",
            "next": "koop_ds_horchen_fehl",
            "requires_flags": [
              "koop_aktiv",
              "koop_ds_horchen_angenommen",
              "koop_ds_horchen_p1",
              "koop_ds_horchen_p2",
              "koop_ds_horchen_ruf_laeuft"
            ]
          },
          {
            "text": "Abbrechen.",
            "next": "koop_ds_horchen_abbruch"
          }
        ]
      },
      "koop_ds_horchen_fehl": {
        "text": "Die Richtung passt nicht zur sichtbaren Antwort. Stellt euch neu auf. Ein neuer Ruf kostet wieder eine Ladung.",
        "choices": [
          {
            "text": "Weiter."
          }
        ],
        "clears_flags": [
          "koop_ds_horchen_p1",
          "koop_ds_horchen_p2",
          "koop_ds_horchen_ruf_laeuft"
        ]
      },
      "koop_ds_horchen_abbruch": {
        "text": "Ihr lasst die Plätze los. Der Rückweg bleibt frei; der begonnene Ruf wird nicht erstattet.",
        "choices": [
          {
            "text": "Weiter."
          }
        ],
        "clears_flags": [
          "koop_ds_horchen_p1",
          "koop_ds_horchen_p2",
          "koop_ds_horchen_ruf_laeuft"
        ]
      },
      "koop_ds_horchen_erfolg": {
        "text": "Der Hinterzugang bleibt offen. Pfiff drückt euch 40 Schilling in die Hand. „So kann ich euch wenigstens von hinten hereinlassen.“",
        "choices": [
          {
            "text": "Weiter."
          }
        ],
        "sets_flags": [
          "koop_ds_hinterzugang",
          "koop_ds_horchen_fertig"
        ],
        "clears_flags": [
          "koop_ds_horchen_p1",
          "koop_ds_horchen_p2",
          "koop_ds_horchen_ruf_laeuft"
        ],
        "gives_money": 40,
        "bond": {
          "k3_pfiff": 1
        },
        "complete_quests": [
          "koop_ds_horchen"
        ]
      },
      "koop_ds_horchen_quittung": {
        "text": "Der Hinterzugang ist bereits offen. Pfiffs Prämie wurde ausgezahlt.",
        "choices": [
          {
            "text": "Weiter."
          }
        ]
      }
    }
